{% extends 'base.html.twig' %}

{% block title %}Nouveau Menu - Brazil Burger{% endblock %}

{% block nav_catalog %}active{% endblock %}

{% block body %}
<div class="container-fluid">
    <!-- Navigation retour -->
    <div class="mb-4">
        <a href="{{ path('app_catalogue') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour au catalogue
        </a>
    </div>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Nouveau Menu</h1>
    </div>

    <!-- Formulaire -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <form method="post" action="{{ path('app_catalogue_menu_new') }}">
                        <div class="row">
                            <div class="col-12 mb-3">
                                <label for="name" class="form-label">Nom du Menu *</label>
                                <input type="text" class="form-control" id="name" name="name" required>
                            </div>
                            
                            <div class="col-12 mb-3">
                                <label for="imageUrl" class="form-label">URL de l'image *</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-link-45deg"></i>
                                    </span>
                                    <input type="url" class="form-control" id="imageUrl" name="imageUrl" 
                                           placeholder="https://res.cloudinary.com/..." required>
                                </div>
                            </div>
                            
                            <div class="col-12 mb-3">
                                <label class="form-label">Burgers à inclure *</label>
                                <div class="border rounded p-3 bg-light" style="max-height: 300px; overflow-y: auto;">
                                    {% if burgers|length > 0 %}
                                        {% for burger in burgers %}
                                        <div class="form-check mb-2">
                                            <input class="form-check-input burger-checkbox" type="checkbox" 
                                                   id="burger{{ burger.id }}" 
                                                   name="burgers[]" 
                                                   value="{{ burger.id }}"
                                                   data-price="{{ burger.price }}">
                                            <label class="form-check-label" for="burger{{ burger.id }}">
                                                {{ burger.name }} - <span class="text-success fw-bold">{{ burger.price|format_currency('XOF') }}</span>
                                            </label>
                                        </div>
                                        {% endfor %}
                                    {% else %}
                                        <p class="text-muted text-center">
                                            <i class="bi bi-exclamation-triangle"></i> 
                                            Aucun burger disponible. Créez d'abord des burgers.
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                            
                            <div class="col-12">
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle"></i> 
                                    Le prix du menu sera automatiquement calculé comme la somme des prix des burgers sélectionnés.
                                </div>
                            </div>
                            
                            <div class="col-12">
                                <div id="totalPriceContainer" class="alert alert-success d-none">
                                    <strong>Prix total du menu : <span id="totalPrice">0</span> XOF</strong>
                                </div>
                            </div>
                            
                            <div class="col-12">
                                <button type="submit" class="btn btn-success" {% if burgers|length == 0 %}disabled{% endif %}>
                                    <i class="bi bi-plus-circle"></i> Créer le Menu
                                </button>
                                <a href="{{ path('app_catalogue') }}" class="btn btn-secondary">Annuler</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Aide</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <h6><i class="bi bi-info-circle"></i> Comment créer un menu</h6>
                        <ul class="mb-0">
                            <li>Donnez un nom clair au menu (ex: "Menu Famille")</li>
                            <li>Sélectionnez les burgers qui composeront le menu</li>
                            <li>Le prix est calculé automatiquement</li>
                            <li>Ajoutez une image attractive du menu</li>
                        </ul>
                    </div>
                    
                    <div class="alert alert-warning">
                        <h6><i class="bi bi-lightbulb"></i> Conseils</h6>
                        <ul class="mb-0">
                            <li>Un menu doit contenir au moins 1 burger</li>
                            <li>Choisissez des burgers complémentaires</li>
                            <li>Pensez aux combinaisons populaires</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const checkboxes = document.querySelectorAll('.burger-checkbox');
    const totalPriceElement = document.getElementById('totalPrice');
    const totalPriceContainer = document.getElementById('totalPriceContainer');
    const submitButton = document.querySelector('button[type="submit"]');
    
    function updateTotalPrice() {
        let total = 0;
        let selectedCount = 0;
        
        checkboxes.forEach(checkbox => {
            if (checkbox.checked) {
                total += parseFloat(checkbox.dataset.price);
                selectedCount++;
            }
        });
        
        // Mettre à jour l'affichage
        totalPriceElement.textContent = total.toLocaleString('fr-FR', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
        
        if (selectedCount > 0) {
            totalPriceContainer.classList.remove('d-none');
            if (submitButton.disabled) {
                submitButton.disabled = false;
            }
        } else {
            totalPriceContainer.classList.add('d-none');
            if (!submitButton.disabled && checkboxes.length > 0) {
                submitButton.disabled = false;
            }
        }
    }
    
    // Ajouter les écouteurs d'événements
    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', updateTotalPrice);
    });
    
    // Initialiser
    updateTotalPrice();
});
</script>
{% endblock %}