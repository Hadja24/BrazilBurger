{% extends 'base.html.twig' %}


{% block title %}Catalogue - Brazil Burger{% endblock %}

{% block nav_catalog %}active{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Styles spécifiques au catalogue */
    :root {
        --catalog-card-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        --catalog-card-shadow-hover: 0 15px 40px rgba(0, 0, 0, 0.12);
        --product-image-height: 200px;
        --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .catalog-header {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: var(--box-shadow);
        position: relative;
        overflow: hidden;
    }

    .catalog-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    .section-title {
        font-weight: 700;
        color: white;
        position: relative;
        display: inline-block;
        padding-bottom: 8px;
    }

    .section-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 60px;
        height: 3px;
        background: white;
        border-radius: 2px;
    }

    .product-card {
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 12px;
        overflow: hidden;
        transition: var(--transition-smooth);
        height: 100%;
        background: white;
        position: relative;
    }

    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--catalog-card-shadow-hover);
        border-color: rgba(231, 57, 70, 0.2);
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }

    .product-image-container {
        height: var(--product-image-height);
        overflow: hidden;
        position: relative;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: var(--transition-smooth);
    }

    .product-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        z-index: 2;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
    }

    .archived-badge {
        background: linear-gradient(135deg, var(--warning-color) 0%, #d39e00 100%);
        color: white;
    }

    .product-content {
        padding: 20px;
        position: relative;
    }

    .product-title {
        font-weight: 600;
        color: var(--text-dark);
        font-size: 1.1rem;
        margin-bottom: 8px;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-price {
        font-weight: 700;
        font-size: 1.3rem;
        margin-bottom: 15px;
        background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .product-actions {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    .btn-edit, .btn-archive {
        flex: 1;
        padding: 8px 15px;
        border-radius: 8px;
        font-weight: 500;
        transition: var(--transition-smooth);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
    }

    .btn-edit {
        background: linear-gradient(135deg, var(--info-color) 0%, #2586c6 100%);
        color: white;
    }

    .btn-edit:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(52, 152, 219, 0.3);
    }

    .btn-archive {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        color: white;
    }

    .btn-archive:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(231, 57, 70, 0.3);
    }

    .empty-state {
        text-align: center;
        padding: 50px 20px;
        background: rgba(0, 0, 0, 0.02);
        border-radius: 12px;
        margin: 20px 0;
    }

    .empty-state i {
        font-size: 3rem;
        margin-bottom: 20px;
        opacity: 0.3;
    }

    .empty-state h4 {
        color: var(--text-light);
        font-weight: 500;
        margin-bottom: 10px;
    }

    .filter-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: var(--box-shadow);
        margin-bottom: 30px;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .input-group {
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.08);
    }

    .input-group:focus-within {
        border-color: var(--primary-color);
        box-shadow: 0 4px 20px rgba(231, 57, 70, 0.1);
    }

    .input-group-text {
        background: white;
        border: none;
        color: var(--text-light);
    }

    .form-control, .form-select {
        border: none;
        padding: 12px 15px;
        font-size: 0.95rem;
    }

    .form-control:focus, .form-select:focus {
        box-shadow: none;
    }

    .btn-filter {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px 25px;
        font-weight: 500;
        transition: var(--transition-smooth);
    }

    .btn-filter:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(231, 57, 70, 0.3);
    }

    .section-counter {
        background: white;
        color: var(--primary-color);
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.9rem;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
    }

    .dropdown-add {
        background: linear-gradient(135deg, #c12727 0%, #8b0000 100%);
        border: none;
        padding: 12px 25px;
        border-radius: 10px;
        font-weight: 600;
        transition: var(--transition-smooth);
        box-shadow: 0 5px 20px rgba(193, 39, 39, 0.3);
        color: white;
        position: relative;
        overflow: hidden;
    }

    .dropdown-add:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(148, 49, 56, 0.3);
    }

    .dropdown-menu {
        border-radius: 10px;
        box-shadow: var(--box-shadow);
        border: 1px solid rgba(0, 0, 0, 0.08);
        padding: 10px 0;
    }

    .dropdown-item {
        padding: 10px 20px;
        font-weight: 500;
        transition: var(--transition-smooth);
        border-radius: 6px;
        margin: 0 5px;
    }

    .dropdown-item:hover {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        color: white;
        transform: translateX(5px);
    }

    /* Animation pour l'apparition des cartes */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .product-card {
        animation: fadeInUp 0.5s ease forwards;
        animation-delay: calc(var(--animation-order, 0) * 0.1s);
        opacity: 0;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .product-image-container {
            height: 180px;
        }
        
        .product-content {
            padding: 15px;
        }
        
        .product-actions {
            flex-direction: column;
        }
        
        .catalog-header {
            padding: 20px;
        }
    }

    @media (max-width: 576px) {
        .product-image-container {
            height: 160px;
        }
        
        .filter-card .row {
            gap: 15px;
        }
        
        .filter-card .col-md-4 {
            width: 100%;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <!-- Header avec bouton d'ajout -->
    <div class="catalog-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="h2 mb-2 text-white"><i class="fas fa-boxes me-2"></i>Catalogue des Produits</h1>
                <p class="text-white mb-0 opacity-75">Gérez l'ensemble de votre offre produits</p>
            </div>
            <div class="col-md-4 text-md-end">
                <div class="dropdown">
                    <button type="button" class="dropdown-add dropdown-toggle d-inline-flex align-items-center" 
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-plus-circle me-2"></i> Ajouter un produit
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="{{ path('app_catalogue_burger_new') }}">
                            <i class="fas fa-hamburger me-2"></i> Nouveau Burger
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_catalogue_menu_new') }}">
                            <i class="fas fa-box me-2"></i> Nouveau Menu
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_catalogue_extra_new') }}">
                            <i class="fas fa-wine-glass-alt me-2"></i> Nouveau Complément
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtres -->
    <div class="filter-card">
        <h5 class="mb-3 fw-600"><i class="fas fa-filter me-2"></i>Filtres et Recherche</h5>
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-500 mb-2">Recherche</label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" class="form-control" placeholder="Nom du produit..." id="searchInput">
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-500 mb-2">Catégorie</label>
                <select class="form-select" id="categoryFilter">
                    <option value="">Toutes les catégories</option>
                    <option value="burger">🍔 Burgers</option>
                    <option value="menu">📦 Menus</option>
                    <option value="extra">🥤 Compléments</option>
                </select>
            </div>
            <div class="col-md-4">
                <button class="btn-filter w-100 d-flex align-items-center justify-content-center" 
                        onclick="applyFilters()">
                    <i class="fas fa-sliders-h me-2"></i> Appliquer les filtres
                </button>
            </div>
        </div>
        <div class="mt-3 text-end">
            <small class="text-muted">
                <span id="totalProducts">{{ burgers|length + menus|length + extras|length }}</span> produits trouvés
            </small>
        </div>
    </div>

    <!-- Section Burgers -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center" 
             style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);">
            <div class="d-flex align-items-center">
                <i class="fas fa-hamburger me-3 text-white fs-4"></i>
                <h2 class="h5 mb-0 text-white">Burgers</h2>
            </div>
            <span class="section-counter" id="burgerCount">{{ burgers|length }}</span>
        </div>
        <div class="card-body">
            {% if burgers|length > 0 %}
                <div class="row">
                    {% for burger in burgers %}
                        <div class="col-xl-3 col-lg-4 col-md-6 mb-4 burger-item" 
                             style="--animation-order: {{ loop.index0 }};">
                            <div class="product-card">
                                <div class="product-image-container">
                                    <img src="{{ burger.imageUrl ?: asset('images/placeholder-burger.jpg') }}" 
                                         alt="{{ burger.name }}" 
                                         class="product-image">
                                    {% if burger.archived %}
                                        <div class="product-badge archived-badge">
                                            <i class="fas fa-archive me-1"></i> Archivé
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="product-content">
                                    <h5 class="product-title">{{ burger.name }}</h5>
                                    <div class="product-price">
                                        {{ burger.price|format_currency('XOF') }}
                                    </div>
                                    <div class="product-actions">
                                        <a href="{{ path('app_catalogue_burger_edit', {'id': burger.id}) }}" 
                                           class="btn-edit">
                                            <i class="fas fa-edit"></i> Modifier
                                        </a>
                                        <form method="post" 
                                              action="{{ path('app_catalogue_burger_archive', {'id': burger.id}) }}"
                                              class="archive-form"
                                              onsubmit="return confirm('{{ burger.archived ? 'Désarchiver' : 'Archiver' }} ce burger ?');">
                                            <button type="submit" class="btn-archive">
                                                <i class="fas fa-{{ burger.archived ? 'redo' : 'archive' }}"></i> 
                                                {{ burger.archived ? 'Restaurer' : 'Archiver' }}
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <i class="fas fa-hamburger text-muted"></i>
                    <h4>Aucun burger disponible</h4>
                    <p class="text-muted">Commencez par ajouter votre premier burger</p>
                    <a href="{{ path('app_catalogue_burger_new') }}" class="btn btn-primary mt-2">
                        <i class="fas fa-plus me-2"></i> Créer un burger
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Section Menus -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center" 
             style="background: linear-gradient(135deg, var(--success-color) 0%, #1e8449 100%);">
            <div class="d-flex align-items-center">
                <i class="fas fa-box me-3 text-white fs-4"></i>
                <h2 class="h5 mb-0 text-white">Menus</h2>
            </div>
            <span class="section-counter" id="menuCount">{{ menus|length }}</span>
        </div>
        <div class="card-body">
            {% if menus|length > 0 %}
                <div class="row">
                    {% for menu in menus %}
                        <div class="col-xl-3 col-lg-4 col-md-6 mb-4 menu-item" 
                             style="--animation-order: {{ loop.index0 }};">
                            <div class="product-card">
                                <div class="product-image-container">
                                    <img src="{{ menu.imageUrl ?: asset('images/placeholder-menu.jpg') }}" 
                                         alt="{{ menu.name }}" 
                                         class="product-image">
                                    {% if menu.archived %}
                                        <div class="product-badge archived-badge">
                                            <i class="fas fa-archive me-1"></i> Archivé
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="product-content">
                                    <h5 class="product-title">{{ menu.name }}</h5>
                                    <div class="product-price">
                                        {{ menu.price|format_currency('XOF') }}
                                    </div>
                                    {% if menu.burgers|length > 0 %}
                                        <div class="mb-3">
                                            <small class="text-muted d-block mb-1">
                                                <i class="fas fa-list-check me-1"></i> Contient :
                                            </small>
                                            {% for burger in menu.burgers|slice(0, 2) %}
                                                <span class="badge bg-light text-dark me-1 mb-1">
                                                    {{ burger.name }}
                                                </span>
                                            {% endfor %}
                                            {% if menu.burgers|length > 2 %}
                                                <span class="badge bg-light text-dark">
                                                    +{{ menu.burgers|length - 2 }}
                                                </span>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                    <div class="product-actions">
                                        <a href="{{ path('app_catalogue_menu_edit', {'id': menu.id}) }}" 
                                           class="btn-edit">
                                            <i class="fas fa-edit"></i> Modifier
                                        </a>
                                        <form method="post" 
                                              action="{{ path('app_catalogue_menu_archive', {'id': menu.id}) }}"
                                              class="archive-form"
                                              onsubmit="return confirm('{{ menu.archived ? 'Désarchiver' : 'Archiver' }} ce menu ?');">
                                            <button type="submit" class="btn-archive">
                                                <i class="fas fa-{{ menu.archived ? 'redo' : 'archive' }}"></i> 
                                                {{ menu.archived ? 'Restaurer' : 'Archiver' }}
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <i class="fas fa-box text-muted"></i>
                    <h4>Aucun menu disponible</h4>
                    <p class="text-muted">Créez des menus combinant vos burgers et compléments</p>
                    <a href="{{ path('app_catalogue_menu_new') }}" class="btn btn-success mt-2">
                        <i class="fas fa-plus me-2"></i> Créer un menu
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Section Compléments -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center" 
             style="background: linear-gradient(135deg, var(--accent-color) 0%, #d68910 100%);">
            <div class="d-flex align-items-center">
                <i class="fas fa-wine-glass-alt me-3 text-white fs-4"></i>
                <h2 class="h5 mb-0 text-white">Compléments</h2>
            </div>
            <span class="section-counter" id="extraCount">{{ extras|length }}</span>
        </div>
        <div class="card-body">
            {% if extras|length > 0 %}
                <div class="row">
                    {% for extra in extras %}
                        <div class="col-xl-3 col-lg-4 col-md-6 mb-4 extra-item" 
                             style="--animation-order: {{ loop.index0 }};">
                            <div class="product-card">
                                <div class="product-image-container">
                                    <img src="{{ extra.imageUrl ?: asset('images/placeholder-extra.jpg') }}" 
                                         alt="{{ extra.name }}" 
                                         class="product-image">
                                    {% if extra.archived %}
                                        <div class="product-badge archived-badge">
                                            <i class="fas fa-archive me-1"></i> Archivé
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="product-content">
                                    <h5 class="product-title">{{ extra.name }}</h5>
                                    <div class="product-price">
                                        {{ extra.price|format_currency('XOF') }}
                                    </div>
                                    <div class="product-actions">
                                        <a href="{{ path('app_catalogue_extra_edit', {'id': extra.id}) }}" 
                                           class="btn-edit">
                                            <i class="fas fa-edit"></i> Modifier
                                        </a>
                                        <form method="post" 
                                              action="{{ path('app_catalogue_extra_archive', {'id': extra.id}) }}"
                                              class="archive-form"
                                              onsubmit="return confirm('{{ extra.archived ? 'Désarchiver' : 'Archiver' }} ce complément ?');">
                                            <button type="submit" class="btn-archive">
                                                <i class="fas fa-{{ extra.archived ? 'redo' : 'archive' }}"></i> 
                                                {{ extra.archived ? 'Restaurer' : 'Archiver' }}
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <i class="fas fa-wine-glass-alt text-muted"></i>
                    <h4>Aucun complément disponible</h4>
                    <p class="text-muted">Ajoutez des boissons, frites et autres accompagnements</p>
                    <a href="{{ path('app_catalogue_extra_new') }}" class="btn btn-warning mt-2">
                        <i class="fas fa-plus me-2"></i> Créer un complément
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>

{% block javascripts %}
{{ parent() }}

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Éléments du DOM
    const searchInput = document.getElementById('searchInput');
    const categoryFilter = document.getElementById('categoryFilter');
    const totalProductsSpan = document.getElementById('totalProducts');
    const burgerCountSpan = document.getElementById('burgerCount');
    const menuCountSpan = document.getElementById('menuCount');
    const extraCountSpan = document.getElementById('extraCount');
    
    // Vérifier que les éléments existent
    if (!searchInput || !categoryFilter) {
        console.error('Éléments de filtre non trouvés');
        return;
    }
    
    // Fonction pour formater le prix
    function formatPrice(price) {
        return new Intl.NumberFormat('fr-FR', {
            style: 'currency',
            currency: 'XOF',
            minimumFractionDigits: 0,
            maximumFractionDigits: 0
        }).format(price);
    }
    
    // Fonction pour appliquer les filtres
    function applyFilters() {
        const searchTerm = searchInput.value.toLowerCase().trim();
        const category = categoryFilter.value;
        
        // Récupérer tous les items de produit
        const burgerItems = document.querySelectorAll('.burger-item');
        const menuItems = document.querySelectorAll('.menu-item');
        const extraItems = document.querySelectorAll('.extra-item');
        
        let visibleBurgerCount = 0;
        let visibleMenuCount = 0;
        let visibleExtraCount = 0;
        
        // Filtrer les burgers
        burgerItems.forEach(item => {
            const shouldShow = filterItem(item, 'burger', searchTerm, category);
            item.style.display = shouldShow ? 'block' : 'none';
            if (shouldShow) visibleBurgerCount++;
        });
        
        // Filtrer les menus
        menuItems.forEach(item => {
            const shouldShow = filterItem(item, 'menu', searchTerm, category);
            item.style.display = shouldShow ? 'block' : 'none';
            if (shouldShow) visibleMenuCount++;
        });
        
        // Filtrer les compléments
        extraItems.forEach(item => {
            const shouldShow = filterItem(item, 'extra', searchTerm, category);
            item.style.display = shouldShow ? 'block' : 'none';
            if (shouldShow) visibleExtraCount++;
        });
        
        // Mettre à jour les compteurs
        updateCounters(visibleBurgerCount, visibleMenuCount, visibleExtraCount);
        
        // Animation des cartes visibles
        animateVisibleItems();
    }
    
    // Fonction de filtre pour un item
    function filterItem(item, itemCategory, searchTerm, selectedCategory) {
        // Filtre par catégorie
        if (selectedCategory && selectedCategory !== itemCategory) {
            return false;
        }
        
        // Si pas de terme de recherche, tout afficher
        if (!searchTerm) return true;
        
        // Recherche dans le nom
        const productName = item.querySelector('.product-title')?.textContent.toLowerCase() || '';
        if (productName.includes(searchTerm)) return true;
        
        // Recherche dans la description (pour les menus)
        const productDescription = item.querySelector('.badge')?.textContent.toLowerCase() || '';
        if (productDescription.includes(searchTerm)) return true;
        
        return false;
    }
    
    // Fonction pour mettre à jour les compteurs
    function updateCounters(burgerCount, menuCount, extraCount) {
        if (burgerCountSpan) burgerCountSpan.textContent = burgerCount;
        if (menuCountSpan) menuCountSpan.textContent = menuCount;
        if (extraCountSpan) extraCountSpan.textContent = extraCount;
        if (totalProductsSpan) totalProductsSpan.textContent = burgerCount + menuCount + extraCount;
    }
    
    // Fonction pour animer les items visibles
    function animateVisibleItems() {
        const allItems = document.querySelectorAll('.burger-item, .menu-item, .extra-item');
        let visibleIndex = 0;
        
        allItems.forEach(item => {
            if (item.style.display !== 'none') {
                item.style.setProperty('--animation-order', visibleIndex);
                visibleIndex++;
            }
        });
    }
    
    // Événements
    searchInput.addEventListener('input', function() {
        applyFilters();
    });
    
    categoryFilter.addEventListener('change', function() {
        applyFilters();
    });
    
    // Ajouter un délai pour éviter trop d'appels lors de la saisie
    let searchTimeout;
    searchInput.addEventListener('keyup', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(applyFilters, 300);
    });
    
    // Confirmation personnalisée pour les formulaires d'archivage
    document.querySelectorAll('.archive-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            const button = this.querySelector('button[type="submit"]');
            const action = button.textContent.includes('Archiver') ? 'archiver' : 'restaurer';
            const productName = this.closest('.product-card').querySelector('.product-title').textContent;
            
            if (!confirm(`Voulez-vous vraiment ${action} "${productName}" ?`)) {
                e.preventDefault();
            }
        });
    });
    
    // Animation au chargement
    setTimeout(() => {
        animateVisibleItems();
    }, 100);
    
    // Appliquer les filtres au chargement (au cas où il y aurait des paramètres)
    applyFilters();
    
    // Debug: vérifier que les éléments sont bien attachés
    console.log('Catalogue initialisé avec succès');
});

// Exposer la fonction applyFilters globalement pour le bouton
function applyFilters() {
    document.dispatchEvent(new Event('DOMContentLoaded'));
}
</script>
{% endblock %}
