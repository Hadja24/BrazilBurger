{% extends 'base.html.twig' %}

{% block title %}Modifier Menu - {{ menu.name }}{% endblock %}

{% block nav_catalog %}active{% endblock %}

{% block body %}
<div class="container-fluid">
    <!-- Navigation retour -->
    <div class="mb-4">
        <a href="{{ path('app_catalogue') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour au catalogue
        </a>
    </div>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Modifier le Menu</h1>
        {% if menu.archived %}
            <span class="badge bg-warning">Archivé</span>
        {% endif %}
    </div>

    <!-- Formulaire -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <form method="post" action="{{ path('app_catalogue_menu_edit', {'id': menu.id}) }}">
                        <div class="row">
                            <div class="col-12 mb-3">
                                <label for="name" class="form-label">Nom du Menu *</label>
                                <input type="text" class="form-control" id="name" name="name" 
                                       value="{{ menu.name }}" required>
                            </div>
                            
                            <div class="col-12 mb-3">
                                <label for="imageUrl" class="form-label">URL de l'image *</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-link-45deg"></i>
                                    </span>
                                    <input type="url" class="form-control" id="imageUrl" name="imageUrl" 
                                           value="{{ menu.imageUrl }}" required>
                                </div>
                            </div>
                            
                            <div class="col-12 mb-3">
                                <label class="form-label">Burgers à inclure *</label>
                                <div class="border rounded p-3 bg-light" style="max-height: 300px; overflow-y: auto;">
                                    {% if burgers|length > 0 %}
                                        {% for burger in burgers %}
                                        <div class="form-check mb-2">
                                            <input class="form-check-input burger-checkbox" type="checkbox" 
                                                   id="burger{{ burger.id }}" 
                                                   name="burgers[]" 
                                                   value="{{ burger.id }}"
                                                   data-price="{{ burger.price }}"
                                                   {% if menu.burgers.contains(burger) %}checked{% endif %}>
                                            <label class="form-check-label" for="burger{{ burger.id }}">
                                                {{ burger.name }} - <span class="text-success fw-bold">{{ burger.price|format_currency('XOF') }}</span>
                                            </label>
                                        </div>
                                        {% endfor %}
                                    {% else %}
                                        <p class="text-muted text-center">
                                            <i class="bi bi-exclamation-triangle"></i> 
                                            Aucun burger disponible.
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                            
                            <div class="col-12">
                                <div id="totalPriceContainer" class="alert alert-success">
                                    <strong>Prix total du menu : <span id="totalPrice">{{ menu.price|format_currency('XOF') }}</span></strong>
                                </div>
                            </div>
                            
                            <div class="col-12">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-save"></i> Sauvegarder
                                </button>
                                <a href="{{ path('app_catalogue') }}" class="btn btn-secondary">Annuler</a>
                                
                                {% if not menu.archived %}
                                    <form method="post" 
                                          action="{{ path('app_catalogue_menu_archive', {'id': menu.id}) }}"
                                          class="d-inline"
                                          onsubmit="return confirm('Archiver ce menu ? Il ne sera plus visible dans le catalogue.');">
                                        <button type="submit" class="btn btn-outline-warning">
                                            <i class="bi bi-archive"></i> Archiver
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <!-- Aperçu -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Aperçu</h5>
                </div>
                <div class="card-body text-center">
                    <img src="{{ menu.imageUrl }}" 
                         alt="{{ menu.name }}" 
                         class="img-fluid rounded mb-3" 
                         style="max-height: 200px; object-fit: cover;"
                         id="imagePreview">
                    <h5 id="namePreview">{{ menu.name }}</h5>
                    <p class="text-success fw-bold fs-5" id="pricePreview">{{ menu.price|format_currency('XOF') }}</p>
                </div>
            </div>
            
            <!-- Composition actuelle -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-list-check"></i> Composition actuelle</h5>
                </div>
                <div class="card-body">
                    {% if menu.burgers|length > 0 %}
                        <ul class="list-group list-group-flush">
                            {% for burger in menu.burgers %}
                            <li class="list-group-item d-flex justify-content-between">
                                <span>{{ burger.name }}</span>
                                <span class="text-success">{{ burger.price|format_currency('XOF') }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted text-center">Aucun burger dans ce menu</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const checkboxes = document.querySelectorAll('.burger-checkbox');
    const totalPriceElement = document.getElementById('totalPrice');
    const nameInput = document.getElementById('name');
    const imageUrlInput = document.getElementById('imageUrl');
    const namePreview = document.getElementById('namePreview');
    const imagePreview = document.getElementById('imagePreview');
    const pricePreview = document.getElementById('pricePreview');
    
    function updateTotalPrice() {
        let total = 0;
        
        checkboxes.forEach(checkbox => {
            if (checkbox.checked) {
                total += parseFloat(checkbox.dataset.price);
            }
        });
        
        // Mettre à jour l'affichage
        const formattedPrice = new Intl.NumberFormat('fr-FR', {
            style: 'currency',
            currency: 'XOF',
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }).format(total);
        
        totalPriceElement.textContent = formattedPrice;
        pricePreview.textContent = formattedPrice;
    }
    
    // Ajouter les écouteurs d'événements
    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', updateTotalPrice);
    });
    
    // Mise à jour en temps réel du nom et de l'image
    nameInput.addEventListener('input', function() {
        namePreview.textContent = this.value || '{{ menu.name }}';
    });
    
    imageUrlInput.addEventListener('input', function() {
        imagePreview.src = this.value || '{{ menu.imageUrl }}';
    });
    
    // Initialiser
    updateTotalPrice();
});
</script>
{% endblock %}