{% extends 'base.html.twig' %}

{% block title %}Modifier Complément - {{ extra.name }}{% endblock %}

{% block nav_catalog %}active{% endblock %}

{% block body %}
<div class="container-fluid">
    <!-- Navigation retour -->
    <div class="mb-4">
        <a href="{{ path('app_catalogue') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour au catalogue
        </a>
    </div>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Modifier le Complément</h1>
        {% if extra.archived %}
            <span class="badge bg-warning">Archivé</span>
        {% endif %}
    </div>

    <!-- Formulaire -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <form method="post" action="{{ path('app_catalogue_extra_edit', {'id': extra.id}) }}">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="name" class="form-label">Nom du Complément *</label>
                                <input type="text" class="form-control" id="name" name="name" 
                                       value="{{ extra.name }}" required>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label for="price" class="form-label">Prix (XOF) *</label>
                                <input type="number" step="0.01" class="form-control" id="price" name="price" 
                                       value="{{ extra.price }}" required>
                            </div>
                            
                            <div class="col-12 mb-3">
                                <label for="imageUrl" class="form-label">URL de l'image *</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-link-45deg"></i>
                                    </span>
                                    <input type="url" class="form-control" id="imageUrl" name="imageUrl" 
                                           value="{{ extra.imageUrl }}" required>
                                </div>
                            </div>
                            
                            <div class="col-12">
                                <button type="submit" class="btn btn-warning">
                                    <i class="bi bi-save"></i> Sauvegarder
                                </button>
                                <a href="{{ path('app_catalogue') }}" class="btn btn-secondary">Annuler</a>
                                
                                {% if not extra.archived %}
                                    <form method="post" 
                                          action="{{ path('app_catalogue_extra_archive', {'id': extra.id}) }}"
                                          class="d-inline"
                                          onsubmit="return confirm('Archiver ce complément ? Il ne sera plus visible dans le catalogue.');">
                                        <button type="submit" class="btn btn-outline-warning">
                                            <i class="bi bi-archive"></i> Archiver
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <!-- Aperçu -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Aperçu</h5>
                </div>
                <div class="card-body text-center">
                    <img src="{{ extra.imageUrl }}" 
                         alt="{{ extra.name }}" 
                         class="img-fluid rounded mb-3" 
                         style="max-height: 200px; object-fit: cover;"
                         id="imagePreview">
                    <h5 id="namePreview">{{ extra.name }}</h5>
                    <p class="text-warning fw-bold fs-5" id="pricePreview">{{ extra.price|format_currency('XOF') }}</p>
                </div>
            </div>
            
            <!-- Statistiques -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-graph-up"></i> Informations</h5>
                </div>
                <div class="card-body">
                    <p class="small text-muted">
                        Ce complément peut être ajouté à n'importe quelle commande.
                        Les clients peuvent en commander plusieurs exemplaires.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Prévisualisation en temps réel
document.addEventListener('DOMContentLoaded', function() {
    const nameInput = document.getElementById('name');
    const priceInput = document.getElementById('price');
    const imageUrlInput = document.getElementById('imageUrl');
    
    const namePreview = document.getElementById('namePreview');
    const pricePreview = document.getElementById('pricePreview');
    const imagePreview = document.getElementById('imagePreview');
    
    nameInput.addEventListener('input', function() {
        namePreview.textContent = this.value || '{{ extra.name }}';
    });
    
    priceInput.addEventListener('input', function() {
        const price = parseFloat(this.value) || {{ extra.price }};
        pricePreview.textContent = new Intl.NumberFormat('fr-FR', {
            style: 'currency',
            currency: 'XOF'
        }).format(price);
    });
    
    imageUrlInput.addEventListener('input', function() {
        imagePreview.src = this.value || '{{ extra.imageUrl }}';
    });
});
</script>
{% endblock %}