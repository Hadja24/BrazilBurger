{# templates/security/login.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion Admin - Brasil Burger</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-color: #e63946;
            --primary-dark: #d32f2f;
            --secondary-color: #2c3e50;
            --secondary-light: #34495e;
            --accent-color: #f39c12;
            --light-bg: #f8f9fa;
            --card-bg: #ffffff;
            --text-dark: #2d3436;
            --text-light: #636e72;
            --success-color: #27ae60;
            --warning-color: #f1c40f;
            --info-color: #3498db;
            --border-radius: 12px;
            --box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
            --transition: all 0.3s ease;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Poppins', 'Montserrat', sans-serif;
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
            overflow-x: hidden;
        }
        
        /* Effet de particules subtiles */
        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(circle at 20% 30%, rgba(231, 57, 70, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(243, 156, 18, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 40% 80%, rgba(52, 152, 219, 0.05) 0%, transparent 50%);
            pointer-events: none;
            z-index: 0;
        }
        
        .login-container {
            width: 100%;
            max-width: 450px;
            animation: fadeIn 0.8s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            z-index: 1;
        }
        
        .login-card {
            background: rgba(255, 255, 255, 0.97);
            border-radius: 20px;
            box-shadow: 
                0 20px 50px rgba(0, 0, 0, 0.25),
                0 0 100px rgba(231, 57, 70, 0.15);
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: var(--transition);
            backdrop-filter: blur(10px);
        }
        
        .login-card:hover {
            transform: translateY(-8px);
            box-shadow: 
                0 25px 60px rgba(0, 0, 0, 0.3),
                0 0 120px rgba(231, 57, 70, 0.2);
        }
        
        .login-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, #ff6b6b 100%);
            padding: 50px 30px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        /* Effet de brillance */
        .login-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(
                45deg,
                transparent 30%,
                rgba(255, 255, 255, 0.1) 50%,
                transparent 70%
            );
            animation: shine 8s infinite linear;
        }
        
        .logo-container {
            position: relative;
            z-index: 2;
        }
        
        .logo-icon {
            background: white;
            width: 90px;
            height: 90px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px;
            box-shadow: 
                0 10px 30px rgba(0, 0, 0, 0.25),
                inset 0 0 20px rgba(231, 57, 70, 0.1);
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }
        
        .logo-icon::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
            opacity: 0;
            transition: var(--transition);
        }
        
        .logo-icon:hover {
            transform: scale(1.05) rotate(5deg);
            box-shadow: 
                0 15px 40px rgba(0, 0, 0, 0.3),
                inset 0 0 30px rgba(231, 57, 70, 0.15);
        }
        
        .logo-icon:hover::before {
            opacity: 0.1;
        }
        
        .logo-icon i {
            color: var(--primary-color);
            font-size: 42px;
            position: relative;
            z-index: 2;
        }
        
        .login-title {
            color: white;
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 8px;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
            letter-spacing: 0.5px;
        }
        
        .login-subtitle {
            color: rgba(255, 255, 255, 0.9);
            font-size: 0.95rem;
            font-weight: 400;
            max-width: 300px;
            margin: 0 auto;
            line-height: 1.5;
        }
        
        .login-body {
            padding: 50px 40px;
        }
        
        .alert-danger {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 18px 20px;
            font-size: 0.95rem;
            margin-bottom: 30px;
            box-shadow: 0 5px 20px rgba(231, 57, 70, 0.2);
            display: flex;
            align-items: center;
            gap: 12px;
            animation: shake 0.5s ease;
        }
        
        .alert-danger i {
            font-size: 1.3rem;
            flex-shrink: 0;
        }
        
        .form-label {
            color: var(--text-dark);
            font-weight: 600;
            margin-bottom: 12px;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .form-label i {
            color: var(--primary-color);
            font-size: 1.1rem;
        }
        
        .input-group {
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 30px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            transition: var(--transition);
            border: 1px solid rgba(0, 0, 0, 0.05);
            background: white;
        }
        
        .input-group:focus-within {
            box-shadow: 0 5px 25px rgba(231, 57, 70, 0.15);
            border-color: rgba(231, 57, 70, 0.3);
            transform: translateY(-2px);
        }
        
        .input-group-text {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
            border: none;
            color: white;
            width: 55px;
            justify-content: center;
            font-size: 1.2rem;
            transition: var(--transition);
        }
        
        .input-group:focus-within .input-group-text {
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-color) 100%);
        }
        
        .form-control {
            border: none;
            padding: 16px 20px;
            font-size: 1rem;
            background: transparent;
            color: var(--text-dark);
            transition: var(--transition);
        }
        
        .form-control:focus {
            box-shadow: none;
            background: rgba(231, 57, 70, 0.02);
        }
        
        .form-control::placeholder {
            color: rgba(0, 0, 0, 0.35);
            font-weight: 400;
        }
        
        #togglePassword {
            background: white;
            border: none;
            color: var(--text-light);
            width: 55px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }
        
        #togglePassword:hover {
            color: var(--primary-color);
            background: rgba(231, 57, 70, 0.05);
        }
        
        #togglePassword i {
            font-size: 1.2rem;
        }
        
        .btn-login {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
            border: none;
            color: white;
            padding: 18px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 12px;
            width: 100%;
            margin-top: 15px;
            transition: var(--transition);
            box-shadow: 
                0 5px 20px rgba(231, 57, 70, 0.3),
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
            position: relative;
            overflow: hidden;
            letter-spacing: 0.5px;
        }
        
        .btn-login::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.2),
                transparent
            );
            transition: 0.5s;
        }
        
        .btn-login:hover {
            transform: translateY(-3px);
            box-shadow: 
                0 8px 30px rgba(231, 57, 70, 0.4),
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }
        
        .btn-login:hover::before {
            left: 100%;
        }
        
        .btn-login:active {
            transform: translateY(-1px);
        }
        
        .btn-login i {
            margin-right: 12px;
            font-size: 1.2rem;
        }
        
        .footer-info {
            text-align: center;
            margin-top: 40px;
            padding-top: 25px;
            border-top: 1px solid rgba(0, 0, 0, 0.08);
            color: var(--text-light);
            font-size: 0.9rem;
        }
        
        .footer-info p {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 8px;
        }
        
        .footer-info i {
            color: var(--primary-color);
            font-size: 1rem;
        }
        
        .footer-info .small {
            font-size: 0.85rem;
            color: rgba(0, 0, 0, 0.5);
            line-height: 1.5;
            max-width: 300px;
            margin: 10px auto 0;
        }
        
        .copyright {
            text-align: center;
            margin-top: 30px;
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.85rem;
            line-height: 1.6;
        }
        
        .copyright p {
            margin-bottom: 5px;
        }
        
        .copyright .small {
            font-size: 0.8rem;
            opacity: 0.7;
        }
        
        /* Animations */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.95);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        
        @keyframes shine {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }
        
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
            20%, 40%, 60%, 80% { transform: translateX(5px); }
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        
        /* Effet de particules */
        .particles-container {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            pointer-events: none;
            z-index: 0;
        }
        
        .particle {
            position: absolute;
            border-radius: 50%;
            animation: float 6s infinite ease-in-out;
        }
        
        /* Responsive */
        @media (max-width: 576px) {
            .login-body {
                padding: 40px 25px;
            }
            
            .login-header {
                padding: 40px 25px;
            }
            
            .login-title {
                font-size: 1.8rem;
            }
            
            .login-subtitle {
                font-size: 0.9rem;
            }
        }
        
        @media (max-width: 400px) {
            .login-body {
                padding: 35px 20px;
            }
            
            .login-header {
                padding: 35px 20px;
            }
            
            .logo-icon {
                width: 80px;
                height: 80px;
            }
            
            .logo-icon i {
                font-size: 36px;
            }
        }
        
        /* Effet de neige animée (particules) */
        .snowflakes {
            position: absolute;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }
        
        .snowflake {
            position: absolute;
            background: rgba(255, 255, 255, 0.8);
            border-radius: 50%;
            opacity: 0;
            animation: fall linear infinite;
        }
        
        @keyframes fall {
            to {
                transform: translateY(100vh);
                opacity: 0;
            }
        }
    </style>
</head>
<body>
    <div class="particles-container" id="particles"></div>
    
    <div class="login-container">
        <div class="login-card">
            <!-- En-tête avec logo -->
            <div class="login-header">
                <div class="logo-container">
                    <div class="logo-icon">
                        <i class="fas fa-hamburger"></i>
                    </div>
                    <h1 class="login-title">BRASIL BURGER</h1>
                    <p class="login-subtitle">Portail d'administration sécurisé</p>
                </div>
            </div>
            
            <!-- Corps du formulaire -->
            <div class="login-body">
                {% if error %}
                    <div class="alert alert-danger" role="alert">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    </div>
                {% endif %}
                
                <form method="post" id="loginForm">
                    <!-- Champ Email -->
                    <div class="form-group mb-4">
                        <label for="inputEmail" class="form-label">
                            <i class="fas fa-user-circle"></i> Adresse email
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-envelope"></i>
                            </span>
                            <input type="email" value="{{ last_username }}" name="email" 
                                   id="inputEmail" class="form-control" 
                                   placeholder="admin@brasilburger.com" 
                                   required autofocus>
                        </div>
                    </div>
                    
                    <!-- Champ Mot de passe -->
                    <div class="form-group mb-4">
                        <label for="inputPassword" class="form-label">
                            <i class="fas fa-key"></i> Mot de passe
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-lock"></i>
                            </span>
                            <input type="password" name="password" id="inputPassword" 
                                   class="form-control" placeholder="Entrez votre mot de passe" required>
                            <button class="btn" type="button" id="togglePassword">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Token CSRF (important pour la sécurité) -->
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    
                    <!-- Bouton de connexion -->
                    <button type="submit" class="btn btn-login" id="loginButton">
                        <i class="fas fa-sign-in-alt"></i> Se connecter au dashboard
                    </button>
                    
                    <!-- Informations de sécurité -->
                    <div class="footer-info">
                        <p>
                            <i class="fas fa-shield-alt"></i>
                            <span>Session sécurisée & chiffrée</span>
                        </p>
                        <p class="small mt-2">
                            Accès réservé au personnel autorisé de Brasil Burger
                        </p>
                    </div>
                </form>
            </div>
        </div>
        
        <div class="copyright">
            <p>&copy; {{ "now"|date("Y") }} Brasil Burger • Tous droits réservés</p>
            <p class="small">Système de gestion v2.1 • Interface d'administration</p>
        </div>
    </div>
    
    <!-- Scripts JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Afficher/Masquer le mot de passe
        document.getElementById('togglePassword').addEventListener('click', function() {
            const passwordInput = document.getElementById('inputPassword');
            const icon = this.querySelector('i');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
                this.style.color = 'var(--primary-color)';
            } else {
                passwordInput.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
                this.style.color = '';
            }
        });
        
        // Animation du bouton de connexion
        const loginButton = document.getElementById('loginButton');
        const loginForm = document.getElementById('loginForm');
        
        loginForm.addEventListener('submit', function() {
            loginButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Connexion en cours...';
            loginButton.disabled = true;
            loginButton.style.opacity = '0.8';
        });
        
        // Effet de focus sur les champs
        const inputs = document.querySelectorAll('.form-control');
        inputs.forEach(input => {
            input.addEventListener('focus', function() {
                this.parentElement.style.boxShadow = '0 5px 25px rgba(231, 57, 70, 0.2)';
                this.parentElement.style.borderColor = 'rgba(231, 57, 70, 0.4)';
            });
            
            input.addEventListener('blur', function() {
                this.parentElement.style.boxShadow = '0 5px 20px rgba(0, 0, 0, 0.08)';
                this.parentElement.style.borderColor = 'rgba(0, 0, 0, 0.05)';
            });
        });
        
        // Validation basique du formulaire
        loginForm.addEventListener('submit', function(e) {
            const email = document.getElementById('inputEmail').value;
            const password = document.getElementById('inputPassword').value;
            
            if (!email || !password) {
                e.preventDefault();
                showError('Veuillez remplir tous les champs');
                return false;
            }
            
            // Validation basique de l'email
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                e.preventDefault();
                showError('Veuillez entrer une adresse email valide');
                return false;
            }
        });
        
        // Fonction pour afficher une erreur
        function showError(message) {
            // Créer une alerte temporaire
            const alertDiv = document.createElement('div');
            alertDiv.className = 'alert-danger';
            alertDiv.innerHTML = `
                <i class="fas fa-exclamation-circle"></i>
                <div>${message}</div>
            `;
            
            // Insérer avant le formulaire
            loginForm.parentNode.insertBefore(alertDiv, loginForm);
            
            // Supprimer après 5 secondes
            setTimeout(() => {
                alertDiv.remove();
            }, 5000);
            
            // Réactiver le bouton
            loginButton.innerHTML = '<i class="fas fa-sign-in-alt"></i> Se connecter au dashboard';
            loginButton.disabled = false;
            loginButton.style.opacity = '1';
        }
        
        // Créer des particules animées
        function createParticles() {
            const container = document.getElementById('particles');
            const particleCount = 20;
            
            for (let i = 0; i < particleCount; i++) {
                const particle = document.createElement('div');
                particle.classList.add('particle');
                
                // Taille aléatoire
                const size = Math.random() * 8 + 2;
                particle.style.width = `${size}px`;
                particle.style.height = `${size}px`;
                
                // Position aléatoire
                particle.style.left = `${Math.random() * 100}%`;
                particle.style.top = `${Math.random() * 100}%`;
                
                // Couleur avec opacité basée sur la taille
                const colors = [
                    'rgba(231, 57, 70, 0.1)',
                    'rgba(243, 156, 18, 0.1)',
                    'rgba(52, 152, 219, 0.05)',
                    'rgba(255, 255, 255, 0.05)'
                ];
                const color = colors[Math.floor(Math.random() * colors.length)];
                particle.style.background = color;
                
                // Animation
                const duration = Math.random() * 15 + 10;
                const delay = Math.random() * 5;
                particle.style.animation = `float ${duration}s infinite ease-in-out ${delay}s`;
                
                // Ajouter au DOM
                container.appendChild(particle);
            }
        }
        
        // Effet de neige subtile
        function createSnowflakes() {
            const container = document.createElement('div');
            container.className = 'snowflakes';
            document.body.appendChild(container);
            
            const snowflakeCount = 15;
            
            for (let i = 0; i < snowflakeCount; i++) {
                const snowflake = document.createElement('div');
                snowflake.className = 'snowflake';
                
                // Taille très petite
                const size = Math.random() * 2 + 1;
                snowflake.style.width = `${size}px`;
                snowflake.style.height = `${size}px`;
                
                // Position de départ
                snowflake.style.left = `${Math.random() * 100}%`;
                snowflake.style.top = `${Math.random() * -20}%`;
                
                // Couleur blanche très transparente
                snowflake.style.background = 'rgba(255, 255, 255, 0.4)';
                
                // Animation
                const duration = Math.random() * 20 + 10;
                const delay = Math.random() * 5;
                snowflake.style.animation = `fall ${duration}s linear infinite ${delay}s`;
                
                container.appendChild(snowflake);
            }
        }
        
        // Démarrer les effets au chargement
        window.addEventListener('load', function() {
            createParticles();
            createSnowflakes();
            
            // Animation d'entrée pour le formulaire
            const card = document.querySelector('.login-card');
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            
            setTimeout(() => {
                card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, 100);
        });
        
        // Effet hover sur le logo
        const logoIcon = document.querySelector('.logo-icon');
        if (logoIcon) {
            logoIcon.addEventListener('mouseenter', function() {
                this.style.transform = 'scale(1.05) rotate(5deg)';
            });
            
            logoIcon.addEventListener('mouseleave', function() {
                this.style.transform = '';
            });
        }
        
        // Auto-focus sur le champ email
        document.getElementById('inputEmail').focus();
    </script>
</body>
</html>