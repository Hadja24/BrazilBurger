{# templates/base_responsive.html.twig #}
{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/responsive.css') }}">
{% endblock %}

{% block body %}
    <div class="responsive-wrapper">
        {% block responsive_content %}{% endblock %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/responsive.js') }}"></script>
{% endblock %}