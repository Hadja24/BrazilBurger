{% extends 'base.html.twig' %}

{% block title %}Livraisons - Brazil Burger{% endblock %}

{% block body %}
<div class="container-fluid px-4 mt-4">
    <!-- En-tête avec titre et stats -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-2 text-gray-800">🎯 Gestion des Livraisons</h1>
            <p class="text-muted">Suivez et gérez toutes les commandes en attente de livraison</p>
        </div>
        <div class="d-flex">
            <div class="me-3 p-3 bg-light rounded shadow-sm">
                <small class="text-muted">Commandes en attente</small>
                <h4 class="mb-0 text-primary">{{ orders|filter(o => o.deliveryStatus == 'pending')|length }}</h4>
            </div>
        </div>
    </div>

    <!-- Filtres avec carte modernisée -->
    <div class="card border-0 shadow-lg mb-4">
        <div class="card-header bg-gradient-primary text-white py-3 border-0">
            <div class="d-flex align-items-center">
                <i class="fas fa-filter me-2"></i>
                <h5 class="mb-0">Filtres de recherche</h5>
            </div>
        </div>
        <div class="card-body p-4">
            <form method="get" action="{{ path('app_delivery_index') }}" class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <label for="zone" class="form-label fw-semibold">
                        <i class="fas fa-map-marker-alt me-2 text-primary"></i>Zone de livraison
                    </label>
                    <select class="form-select form-select-lg border-0 shadow-sm" id="zone" name="zone">
                        <option value="">🌍 Toutes les zones</option>
                        {% for zone in zones %}
                            <option value="{{ zone.id }}" {{ selectedZone == zone.id ? 'selected' : '' }}>
                                📍 {{ zone.name }} - {{ zone.deliveryPrice }} FCFA
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-lg-4 col-md-6">
                    <label for="status" class="form-label fw-semibold">
                        <i class="fas fa-tag me-2 text-primary"></i>Statut de livraison
                    </label>
                    <select class="form-select form-select-lg border-0 shadow-sm" id="status" name="status">
                        <option value="">🏷️ Tous les statuts</option>
                        {% for key, label in deliveryStatuses %}
                            <option value="{{ key }}" {{ selectedStatus == key ? 'selected' : '' }}>
                                {{ ['⌛', '🚚', '✅', '❌'][loop.index0] ?? '📌' }} {{ label }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-lg-4 col-md-12 d-flex align-items-end">
                    <div class="d-flex gap-2 w-100">
                        <button type="submit" class="btn btn-lg btn-primary shadow-sm px-4 flex-fill">
                            <i class="fas fa-search me-2"></i>Appliquer
                        </button>
                        <a href="{{ path('app_delivery_index') }}" class="btn btn-lg btn-outline-secondary shadow-sm px-3">
                            <i class="fas fa-undo me-2"></i>Réinitialiser
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Liste des commandes -->
    <div class="card border-0 shadow-lg">
        <div class="card-header bg-white py-3 border-bottom">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-dark">
                    <i class="fas fa-boxes me-2 text-primary"></i>Commandes à livrer
                    <span class="badge bg-primary rounded-pill ms-2">{{ orders|length }}</span>
                </h5>
                <div class="dropdown">
                    <button class="btn btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-cog"></i> Options
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#"><i class="fas fa-download me-2"></i> Exporter</a></li>
                        <li><a class="dropdown-item" href="#"><i class="fas fa-print me-2"></i> Imprimer</a></li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="card-body p-0">
            {% if orders|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-0 ps-4">
                                    <i class="fas fa-hashtag text-muted me-2"></i>ID
                                </th>
                                <th class="border-0">
                                    <i class="fas fa-user text-muted me-2"></i>Client
                                </th>
                                <th class="border-0">
                                    <i class="fas fa-money-bill-wave text-muted me-2"></i>Total
                                </th>
                                <th class="border-0">
                                    <i class="fas fa-calendar-alt text-muted me-2"></i>Date
                                </th>
                                <th class="border-0">
                                    <i class="fas fa-map text-muted me-2"></i>Zone
                                </th>
                                <th class="border-0">
                                    <i class="fas fa-truck text-muted me-2"></i>Statut
                                </th>
                                <th class="border-0">
                                    <i class="fas fa-motorcycle text-muted me-2"></i>Livreur
                                </th>
                                <th class="border-0 pe-4 text-end">
                                    <i class="fas fa-cogs text-muted me-2"></i>Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in orders %}
                            <tr class="border-bottom hover-row">
                                <td class="ps-4">
                                    <span class="badge bg-light text-dark border">#{{ order.id }}</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-primary text-white me-3">
                                            {{ order.customer and order.customer.account ? order.customer.account.name|first|upper }}
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-semibold">
                                                {% if order.customer and order.customer.account %}
                                                    {{ order.customer.account.name }} {{ order.customer.account.surname }}
                                                {% else %}
                                                    <span class="text-danger">Client inconnu</span>
                                                {% endif %}
                                            </h6>
                                            <small class="text-muted">
                                                {% if order.customer and order.customer.account and order.customer.account.phone %}
                                                    📱 {{ order.customer.account.phone }}
                                                {% endif %}
                                            </small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold text-success">
                                        {{ order.totalPrice|number_format(0, ',', ' ') }} FCFA
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">{{ order.orderDate|date('d/m/Y') }}</small><br>
                                    <small>{{ order.orderDate|date('H:i') }}</small>
                                </td>
                                <td>
                                    {% if order.zone %}
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info">
                                            <i class="fas fa-map-marker-alt me-1"></i>{{ order.zone.name }}
                                        </span>
                                    {% else %}
                                        <span class="badge bg-warning bg-opacity-10 text-warning">
                                            <i class="fas fa-exclamation-triangle me-1"></i>Non spécifiée
                                        </span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if order.deliveryStatus == 'pending' %}
                                        <span class="badge bg-warning bg-gradient rounded-pill px-3 py-2">
                                            <i class="fas fa-clock me-1"></i>{{ deliveryStatuses[order.deliveryStatus] }}
                                        </span>
                                    {% elseif order.deliveryStatus == 'ongoing' %}
                                        <span class="badge bg-info bg-gradient rounded-pill px-3 py-2">
                                            <i class="fas fa-truck-moving me-1"></i>{{ deliveryStatuses[order.deliveryStatus] }}
                                        </span>
                                    {% elseif order.deliveryStatus == 'delivered' %}
                                        <span class="badge bg-success bg-gradient rounded-pill px-3 py-2">
                                            <i class="fas fa-check-circle me-1"></i>{{ deliveryStatuses[order.deliveryStatus] }}
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary rounded-pill">{{ order.deliveryStatus }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if order.deliveryGuy %}
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-user-check text-success me-2"></i>
                                            <div>
                                                <small class="fw-semibold">{{ order.deliveryGuy.account.name }} {{ order.deliveryGuy.account.surname }}</small><br>
                                                <small class="text-muted">Assigned</small>
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-user-clock text-warning me-2"></i>
                                            <div>
                                                <span class="text-muted fst-italic">À affecter</span>
                                            </div>
                                        </div>
                                    {% endif %}
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group" role="group">
                                        {% if order.deliveryStatus == 'pending' %}
                                            <a href="{{ path('app_delivery_assign', {'id': order.id}) }}" 
                                               class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                                                <i class="fas fa-user-plus me-1"></i>Affecter
                                            </a>
                                        {% else %}
                                            <button class="btn btn-outline-primary btn-sm rounded-pill px-3" disabled>
                                                <i class="fas fa-spinner fa-spin me-1"></i>En cours
                                            </button>
                                        {% endif %}
                                        <button type="button" class="btn btn-light btn-sm ms-2 rounded-circle" 
                                                data-bs-toggle="tooltip" title="Voir les détails">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <div class="empty-state">
                        <i class="fas fa-box-open fa-4x text-muted mb-4"></i>
                        <h4 class="text-muted">Aucune commande à livrer</h4>
                        <p class="text-muted">Toutes les commandes ont été traitées ou aucun filtre ne correspond.</p>
                        <a href="{{ path('app_delivery_index') }}" class="btn btn-outline-primary mt-2">
                            <i class="fas fa-redo me-2"></i>Réinitialiser les filtres
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
        
        {% if orders|length > 10 %}
        <div class="card-footer bg-white py-3">
            <nav aria-label="Navigation des pages">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item disabled"><a class="page-link" href="#">Précédent</a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item"><a class="page-link" href="#">Suivant</a></li>
                </ul>
            </nav>
        </div>
        {% endif %}
    </div>
</div>

<style>
.avatar-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
}

.bg-gradient {
    background: linear-gradient(45deg, #4e73df, #1cc88a);
}

.hover-row:hover {
    background-color: rgba(78, 115, 223, 0.05);
    transform: translateY(-2px);
    transition: all 0.3s ease;
}

.empty-state {
    opacity: 0.6;
}

.badge.bg-gradient {
    background-image: linear-gradient(45deg, transparent, rgba(255,255,255,0.2));
}

.card-header.bg-gradient-primary {
    background: linear-gradient(87deg, #4e73df 0, #224abe 100%) !important;
}
</style>
{% endblock %}