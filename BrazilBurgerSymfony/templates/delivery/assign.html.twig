{% extends 'base.html.twig' %}

{% block title %}Assigner un livreur - Brazil Burger{% endblock %}

{% block body %}
<div class="container-fluid px-4 mt-4">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">
            <!-- En-tête simplifié -->
            <div class="d-flex align-items-center mb-4">
                <a href="{{ path('app_delivery_index') }}" class="btn btn-outline-secondary btn-sm me-3 rounded-circle shadow-sm">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="h3 mb-1 text-dark fw-bold">
                        <i class="fas fa-user-check text-primary me-2"></i>
                        Assigner un livreur
                    </h1>
                    <p class="text-muted mb-0">
                        Commande #{{ order.id }} • {{ order.orderDate|date('d/m/Y H:i') }} • 
                        <span class="badge bg-warning">En attente d'assignation</span>
                    </p>
                </div>
            </div>

            <div class="row g-4">
                <!-- Informations de la commande -->
                <div class="col-lg-7">
                    <div class="card border-0 shadow-lg h-100">
                        <div class="card-header bg-gradient-red text-white py-3 border-0">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle bg-white text-red me-3">
                                    <i class="fas fa-clipboard-list"></i>
                                </div>
                                <div>
                                    <h5 class="mb-0">Détails de la commande</h5>
                                    <small>Commande #{{ order.id }} • {{ order.orderDate|date('d/m/Y H:i') }}</small>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-4">
                                <!-- Informations client -->
                                <div class="col-md-6">
                                    <div class="info-card p-3 bg-light rounded border-start border-4 border-primary">
                                        <small class="text-muted d-block mb-2">
                                            <i class="fas fa-user-circle me-1 text-primary"></i>
                                            Client
                                        </small>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle bg-primary text-white me-3">
                                                {{ order.customer.account.name|first|upper }}
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold">{{ order.customer.account.name }} {{ order.customer.account.surname }}</h6>
                                                <small class="text-muted">📱 {{ order.customer.account.phone }}</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Montant total -->
                                <div class="col-md-6">
                                    <div class="info-card p-3 bg-success bg-opacity-10 rounded border-start border-4 border-success">
                                        <small class="text-muted d-block mb-2">
                                            <i class="fas fa-money-bill-wave me-1 text-success"></i>
                                            Montant total
                                        </small>
                                        <h4 class="mb-0 fw-bold text-success">{{ order.totalPrice|number_format(0, ',', ' ') }} FCFA</h4>
                                    </div>
                                </div>

                                <!-- Type de réception -->
                                <div class="col-md-6">
                                    <div class="info-card p-3 bg-info bg-opacity-10 rounded border-start border-4 border-info">
                                        <small class="text-muted d-block mb-2">
                                            <i class="fas fa-truck me-1 text-info"></i>
                                            Type de réception
                                        </small>
                                        <div class="d-flex align-items-center">
                                            <span class="badge bg-info rounded-pill px-3 py-2">
                                                {% if order.receptionType == 'DELIVERY' %}
                                                    <i class="fas fa-motorcycle me-1"></i>Livraison
                                                {% elseif order.receptionType == 'PICK_UP' %}
                                                    <i class="fas fa-store me-1"></i>À emporter
                                                {% else %}
                                                    <i class="fas fa-utensils me-1"></i>Sur place
                                                {% endif %}
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Statut de la commande -->
                                <div class="col-md-6">
                                    <div class="info-card p-3 bg-warning bg-opacity-10 rounded border-start border-4 border-warning">
                                        <small class="text-muted d-block mb-2">
                                            <i class="fas fa-tag me-1 text-warning"></i>
                                            Statut
                                        </small>
                                        <span class="badge bg-warning rounded-pill px-3 py-2">
                                            <i class="fas fa-clock me-1"></i>
                                            {{ order.orderState == 'PENDING' ? 'En attente' : order.orderState }}
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Zone de livraison -->
                            <div class="mt-4">
                                <div class="delivery-zone-card p-4 bg-light rounded border">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="zone-icon bg-primary text-white rounded-circle p-3 me-3">
                                            <i class="fas fa-map-marked-alt fa-lg"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-1">Zone de livraison</h5>
                                            <p class="mb-0 text-muted">
                                                Sélectionnez un livreur disponible pour cette zone
                                            </p>
                                        </div>
                                    </div>
                                    
                                    {% if order.zone %}
                                        <div class="zone-details p-3 bg-white rounded shadow-sm border">
                                            <div class="row align-items-center">
                                                <div class="col-md-8">
                                                    <h6 class="mb-1 fw-bold">
                                                        <i class="fas fa-globe-africa text-primary me-2"></i>
                                                        {{ order.zone.name }}
                                                    </h6>
                                                    <small class="text-muted">
                                                        Zone de livraison sélectionnée par le client
                                                    </small>
                                                </div>
                                                <div class="col-md-4 text-end">
                                                    {% if order.zone.deliveryPrice %}
                                                        <div class="delivery-price">
                                                            <small class="text-muted d-block">Frais de livraison</small>
                                                            <h5 class="mb-0 text-success fw-bold">
                                                                {{ order.zone.deliveryPrice }} FCFA
                                                            </h5>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="alert alert-warning border-0">
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-exclamation-triangle text-warning me-3 fa-lg"></i>
                                                <div>
                                                    <h6 class="mb-1">Zone non spécifiée</h6>
                                                    <p class="mb-0 small">
                                                        Aucune zone de livraison n'a été spécifiée pour cette commande.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Formulaire d'assignation -->
                <div class="col-lg-5">
                    <div class="card border-0 shadow-lg h-100">
                        <div class="card-header bg-gradient-red text-white py-3 border-0">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle bg-white text-red me-3">
                                    <i class="fas fa-user-plus"></i>
                                </div>
                                <div>
                                    <h5 class="mb-0">Sélection du livreur</h5>
                                    <small>Assignez un livreur disponible</small>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-4 d-flex flex-column">
                            {{ form_start(form) }}
                            
                            <div class="mb-4 flex-grow-1">
                                <label class="form-label fw-semibold mb-3">
                                    <i class="fas fa-motorcycle me-2 text-primary"></i>
                                    Choisir un livreur
                                </label>
                                
                                <div class="form-select-wrapper mb-3">
                                    {{ form_widget(form.deliveryGuy, {
                                        'attr': {
                                            'class': 'form-select form-select-lg border-primary shadow-sm',
                                        }
                                    }) }}
                                    <div class="form-select-icon">
                                        <i class="fas fa-chevron-down"></i>
                                    </div>
                                </div>
                                {{ form_errors(form.deliveryGuy) }}
                                
                                <div class="alert alert-light border mt-3">
                                    <div class="d-flex">
                                        <i class="fas fa-lightbulb text-warning me-3 mt-1"></i>
                                        <div>
                                            <small class="fw-semibold">Conseil d'assignation</small>
                                            <p class="mb-0 small">
                                                {% if order.zone %}
                                                    Choisissez un livreur disponible dans la zone 
                                                    <strong>"{{ order.zone.name }}"</strong> pour réduire le temps de livraison.
                                                {% else %}
                                                    Sélectionnez un livreur disponible. Le client n'a pas spécifié de zone.
                                                {% endif %}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Stats rapides -->
                            <div class="row g-2 mb-4">
                                <div class="col-6">
                                    <div class="stat-card p-2 bg-primary bg-opacity-10 rounded text-center">
                                        <small class="text-muted d-block">Livraison estimée</small>
                                        <span class="fw-bold text-primary">30-45 min</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="stat-card p-2 bg-success bg-opacity-10 rounded text-center">
                                        <small class="text-muted d-block">Distance moyenne</small>
                                        <span class="fw-bold text-success">2.5 km</span>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Boutons d'action -->
                            <div class="mt-auto">
                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm py-3">
                                        <i class="fas fa-check-circle me-2"></i>
                                        Confirmer l'assignation
                                    </button>
                                    <a href="{{ path('app_delivery_index') }}" class="btn btn-outline-secondary rounded-pill py-3">
                                        <i class="fas fa-arrow-left me-2"></i>
                                        Retour aux livraisons
                                    </a>
                                </div>
                            </div>
                            
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section d'information supplémentaire -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm bg-light">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-info-circle text-primary me-3 fa-lg"></i>
                                    <div>
                                        <h6 class="mb-0">Information importante</h6>
                                        <small class="text-muted">
                                            Le livreur recevra une notification et pourra contacter le client si nécessaire.
                                        </small>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <small class="text-muted">
                                        <i class="fas fa-clock me-1"></i>
                                        Assignation en attente
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.avatar-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 1.1rem;
}

.icon-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.zone-icon {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.info-card {
    transition: all 0.3s ease;
    height: 100%;
}

.info-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

.bg-gradient-red {
    background: linear-gradient(135deg, #e63946 0%, #d32f2f 100%) !important;
}

.border-start {
    border-left-width: 4px !important;
}

.form-select-wrapper {
    position: relative;
}

.form-select-wrapper .form-select-icon {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: #6c757d;
}

.stat-card {
    transition: all 0.3s ease;
}

.stat-card:hover {
    background-color: rgba(0,0,0,0.05);
}

.card {
    border-radius: 12px;
    overflow: hidden;
}

.card-header.bg-gradient-red {
    border-radius: 12px 12px 0 0 !important;
}

.btn-lg {
    padding: 0.75rem 1.5rem;
    font-size: 1.1rem;
}

.delivery-price {
    padding: 10px 15px;
    background: rgba(39, 174, 96, 0.1);
    border-radius: 10px;
    display: inline-block;
}

.zone-details {
    transition: all 0.3s ease;
}

.zone-details:hover {
    border-color: rgba(231, 57, 70, 0.4) !important;
    box-shadow: 0 5px 20px rgba(231, 57, 70, 0.1);
}

.text-red {
    color: #e63946 !important;
}

/* Utilisation des variables CSS de base.html.twig */
:root {
    --primary-color: #e63946;
    --primary-dark: #d32f2f;
    --secondary-color: #2c3e50;
    --secondary-light: #34495e;
    --accent-color: #f39c12;
    --light-bg: #f8f9fa;
    --card-bg: #ffffff;
    --text-dark: #2d3436;
    --text-light: #636e72;
    --success-color: #27ae60;
    --warning-color: #f1c40f;
    --info-color: #3498db;
    --border-radius: 12px;
    --box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    --transition: all 0.3s ease;
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
    border-color: transparent;
}

.btn-primary:hover {
    background: linear-gradient(135deg, var(--primary-dark), var(--primary-color));
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(231, 57, 70, 0.3);
}

.badge.bg-warning {
    background-color: var(--warning-color) !important;
}

.badge.bg-info {
    background-color: var(--info-color) !important;
}

.badge.bg-success {
    background-color: var(--success-color) !important;
}

.text-primary {
    color: var(--primary-color) !important;
}

.border-primary {
    border-color: var(--primary-color) !important;
}

.bg-primary {
    background-color: var(--primary-color) !important;
}
</style>
{% endblock %}