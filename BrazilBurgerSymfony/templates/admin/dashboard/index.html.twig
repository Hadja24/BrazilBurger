{% extends 'base.html.twig' %}

{% block title %}Dashboard - Brazil Burger{% endblock %}

{% block nav_dashboard %}active{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="bi bi-cash-coin fs-1 text-success"></i>
                        </div>
                        <div>
                            <h5 class="card-title text-muted">Total Revenue</h5>
                            <h3 class="mb-0">{{ totalRevenue|default(0)|number_format(0, ',', ' ') }} F CFA</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="bi bi-receipt fs-1 text-primary"></i>
                        </div>
                        <div>
                            <h5 class="card-title text-muted">Total Orders</h5>
                            <h3 class="mb-0">{{ totalOrders|default(0) }}</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="bi bi-people fs-1 text-warning"></i>
                        </div>
                        <div>
                            <h5 class="card-title text-muted">Total Customers</h5>
                            <h3 class="mb-0">{{ totalCustomers|default(0) }}</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="bi bi-clock-history fs-1 text-danger"></i>
                        </div>
                        <div>
                            <h5 class="card-title text-muted">Pending Orders</h5>
                            <h3 class="mb-0">{{ pendingOrders|default(0) }}</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Recent Orders</h5>
                </div>
                <div class="card-body">
                    {% if recentOrders|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Customer</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for order in recentOrders %}
                                <tr>
                                    <td>#{{ order.id }}</td>
                                    <td>
                                        {% if order.name is defined %}
                                        {{ order.name }} {{ order.surname }}
                                        {% else %}
                                        Customer #{{ order.id }}
                                        {% endif %}
                                    </td>
                                    <td>{{ order.totalPrice|default(0)|number_format(0, ',', ' ') }} F CFA</td>
                                    <td>
                                        {% if order.orderState == 'FINISHED' %}
                                        <span class="badge bg-success">Completed</span>
                                        {% elseif order.orderState == 'PENDING' %}
                                        <span class="badge bg-warning">Pending</span>
                                        {% elseif order.orderState == 'CANCELLED' %}
                                        <span class="badge bg-danger">Cancelled</span>
                                        {% else %}
                                        <span class="badge bg-secondary">{{ order.orderState }}</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ order.orderDate|date('d/m/Y H:i') }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <div class="text-center py-4">
                        <i class="bi bi-receipt fs-1 text-muted mb-3"></i>
                        <p class="text-muted">No recent orders found</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Order Status Overview</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="p-3">
                                <h2 class="text-warning">{{ pendingOrders|default(0) }}</h2>
                                <p class="text-muted mb-0">Pending</p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3">
                                <h2 class="text-success">{{ finishedOrders|default(0) }}</h2>
                                <p class="text-muted mb-0">Completed</p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3">
                                <h2 class="text-danger">{{ cancelledOrders|default(0) }}</h2>
                                <p class="text-muted mb-0">Cancelled</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Daily Stats</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <p class="text-muted mb-1">Today's Revenue</p>
                            <h4>{{ dailyRevenue|default(0)|number_format(0, ',', ' ') }} F CFA</h4>
                        </div>
                        <div class="col-6">
                            <p class="text-muted mb-1">Today's Orders</p>
                            <h4>{{ dailyOrders|default(0) }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}