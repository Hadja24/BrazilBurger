{% extends 'base.html.twig' %}

{% block title %}Commandes - Brazil Burger{% endblock %}

{% block nav_orders %}active{% endblock %}

{% block page_title %}Gestion des Commandes{% endblock %}
{% block page_subtitle %}Suivez et gérez toutes les commandes{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}">Dashboard</a></li>
    <li class="breadcrumb-item active">Commandes</li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0">
    <!-- Cartes de statistiques rapides -->
    <div class="row mb-4 g-4">
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card orders-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 text-uppercase">Total</h6>
                            <h2 class="card-title mb-0">{{ orders|length }}</h2>
                        </div>
                        <div class="icon-wrapper">
                            <i class="bi bi-receipt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 text-uppercase">En Attente</h6>
                            <h2 class="card-title mb-0">{{ orders|filter(o => o.orderState == 'PENDING')|length }}</h2>
                        </div>
                        <div class="icon-wrapper" style="background: rgba(243, 156, 18, 0.1); color: #f39c12;">
                            <i class="bi bi-clock"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 text-uppercase">Terminées</h6>
                            <h2 class="card-title mb-0">{{ orders|filter(o => o.orderState == 'FINISHED')|length }}</h2>
                        </div>
                        <div class="icon-wrapper" style="background: rgba(39, 174, 96, 0.1); color: #27ae60;">
                            <i class="bi bi-check-circle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 text-uppercase">Livraison</h6>
                            <h2 class="card-title mb-0">{{ orders|filter(o => o.receptionType == 'DELIVERY')|length }}</h2>
                        </div>
                        <div class="icon-wrapper" style="background: rgba(52, 152, 219, 0.1); color: #3498db;">
                            <i class="bi bi-truck"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Filtres et Tableau -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pb-0 pt-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <h5 class="card-title mb-1">Liste des Commandes</h5>
                            <p class="text-muted mb-0">Filtrez et gérez vos commandes</p>
                        </div>
                        <div class="d-flex gap-2">
                            <div class="btn-group" role="group">
                                <a href="{{ path('app_orders_index', {state: 'all', type: current_type}) }}" 
                                   class="btn btn-outline-secondary {{ current_state == 'all' or current_state is empty ? 'active' : '' }}">
                                    Tous
                                </a>
                                <a href="{{ path('app_orders_index', {state: 'PENDING', type: current_type}) }}" 
                                   class="btn btn-outline-warning {{ current_state == 'PENDING' ? 'active' : '' }}">
                                    <i class="bi bi-clock me-1"></i> Attente
                                </a>
                                <a href="{{ path('app_orders_index', {state: 'FINISHED', type: current_type}) }}" 
                                   class="btn btn-outline-success {{ current_state == 'FINISHED' ? 'active' : '' }}">
                                    <i class="bi bi-check-circle me-1"></i> Terminées
                                </a>
                                <a href="{{ path('app_orders_index', {state: 'CANCELLED', type: current_type}) }}" 
                                   class="btn btn-outline-danger {{ current_state == 'CANCELLED' ? 'active' : '' }}">
                                    <i class="bi bi-x-circle me-1"></i> Annulées
                                </a>
                            </div>
                            <a href="{{ path('app_orders_new') }}" class="btn btn-primary">
                                <i class="bi bi-plus-circle me-1"></i>
                                Nouvelle
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="card-body pt-2">
                    <!-- Filtres par type -->
                    <div class="mb-4">
                        <h6 class="mb-3">Filtrer par type de réception :</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <a href="{{ path('app_orders_index', {state: current_state, type: 'all'}) }}" 
                               class="btn btn-sm btn-outline-secondary {{ current_type == 'all' or current_type is empty ? 'active' : '' }}">
                                <i class="bi bi-grid me-1"></i> Tous les types
                            </a>
                            <a href="{{ path('app_orders_index', {state: current_state, type: 'DELIVERY'}) }}" 
                               class="btn btn-sm btn-outline-info {{ current_type == 'DELIVERY' ? 'active' : '' }}">
                                <i class="bi bi-truck me-1"></i> Livraison
                            </a>
                            <a href="{{ path('app_orders_index', {state: current_state, type: 'PICK_UP'}) }}" 
                               class="btn btn-sm btn-outline-warning {{ current_type == 'PICK_UP' ? 'active' : '' }}">
                                <i class="bi bi-bag me-1"></i> À emporter
                            </a>
                            <a href="{{ path('app_orders_index', {state: current_state, type: 'AT_THE_RESTAURANT'}) }}" 
                               class="btn btn-sm btn-outline-success {{ current_type == 'AT_THE_RESTAURANT' ? 'active' : '' }}">
                                <i class="bi bi-shop me-1"></i> Sur place
                            </a>
                        </div>
                    </div>
                    
                    <!-- Indicateur de filtrage -->
                    {% if current_state or current_type %}
                    <div class="alert alert-light border mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-funnel text-primary me-2"></i>
                                <span class="fw-medium">Filtres actifs :</span>
                                {% if current_state and current_state != 'all' %}
                                    <span class="badge bg-primary ms-1">État: {{ current_state }}</span>
                                {% endif %}
                                {% if current_type and current_type != 'all' %}
                                    <span class="badge bg-info ms-1">Type: {{ current_type }}</span>
                                {% endif %}
                            </div>
                            <a href="{{ path('app_orders_index') }}" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i> Effacer
                            </a>
                        </div>
                    </div>
                    {% endif %}
                    
                    <!-- Tableau des commandes -->
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr class="border-light">
                                    <th class="border-0">ID</th>
                                    <th class="border-0">Client</th>
                                    <th class="border-0">Total</th>
                                    <th class="border-0">Date</th>
                                    <th class="border-0">État</th>
                                    <th class="border-0">Type</th>
                                    <th class="border-0 text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for order in orders %}
                                <tr class="border-light">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3">
                                                <i class="bi bi-receipt"></i>
                                            </div>
                                            <div>
                                                <strong>#{{ order.id }}</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-light text-dark d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                                <i class="bi bi-person"></i>
                                            </div>
                                            <div>
                                                {# AFFICHAGE DU NOM ET PRÉNOM DU CLIENT - VERSION SIMPLIFIÉE #}
                                                {% if order.customer is defined and order.customer is not null %}
                                                    <div class="fw-medium">{{ order.customer.name|default('') }} {{ order.customer.surname|default('') }}</div>
                                                    {% if order.customer.phone is defined and order.customer.phone is not empty %}
                                                        <small class="text-muted d-block">
                                                            <i class="bi bi-telephone"></i> {{ order.customer.phone }}
                                                        </small>
                                                    {% endif %}
                                                {% else %}
                                                    <div class="fw-medium">Client #{{ order.id }}</div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </td>
                                    <td class="fw-bold text-success">{{ order.totalPrice }} €</td>
                                    <td>
                                        <div class="fw-bold">{{ order.orderDate|date('d/m/Y') }}</div>
                                        <small class="text-muted">{{ order.orderDate|date('H:i') }}</small>
                                    </td>
                                    <td>
                                        {% if order.orderState == 'PENDING' %}
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill py-1 px-3">
                                                <i class="bi bi-clock me-1"></i>
                                                En attente
                                            </span>
                                        {% elseif order.orderState == 'CANCELLED' %}
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill py-1 px-3">
                                                <i class="bi bi-x-circle me-1"></i>
                                                Annulée
                                            </span>
                                        {% elseif order.orderState == 'FINISHED' %}
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill py-1 px-3">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Terminée
                                            </span>
                                        {% else %}
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill py-1 px-3">
                                                {{ order.orderState }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if order.receptionType == 'DELIVERY' %}
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill py-1 px-3">
                                                <i class="bi bi-truck me-1"></i>
                                                Livraison
                                            </span>
                                        {% elseif order.receptionType == 'PICK_UP' %}
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill py-1 px-3">
                                                <i class="bi bi-bag me-1"></i>
                                                À emporter
                                            </span>
                                        {% elseif order.receptionType == 'AT_THE_RESTAURANT' %}
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill py-1 px-3">
                                                <i class="bi bi-shop me-1"></i>
                                                Sur place
                                            </span>
                                        {% else %}
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill py-1 px-3">
                                                {{ order.receptionType }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ path('app_orders_show', {'id': order.id}) }}" 
                                           class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="bi bi-eye me-1"></i>
                                            Détails
                                        </a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="mb-3">
                                            <i class="bi bi-receipt fs-1 text-muted opacity-25"></i>
                                        </div>
                                        <h5 class="text-muted">Aucune commande trouvée</h5>
                                        <p class="text-muted mb-3">Commencez par créer une nouvelle commande</p>
                                        <a href="{{ path('app_orders_new') }}" class="btn btn-primary">
                                            <i class="bi bi-plus-circle me-1"></i>
                                            Créer une commande
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Animation des filtres
    document.querySelectorAll('.btn-outline-secondary, .btn-outline-warning, .btn-outline-success, .btn-outline-danger, .btn-outline-info').forEach(btn => {
        btn.addEventListener('mouseenter', function() {
            if (!this.classList.contains('active')) {
                this.style.transform = 'translateY(-2px)';
            }
        });
        
        btn.addEventListener('mouseleave', function() {
            if (!this.classList.contains('active')) {
                this.style.transform = 'translateY(0)';
            }
        });
    });
    
    // Auto-dismiss alerts
    const alerts = document.querySelectorAll('.alert');
    alerts.forEach(alert => {
        setTimeout(() => {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        }, 5000);
    });
});
</script>
{% endblock %}