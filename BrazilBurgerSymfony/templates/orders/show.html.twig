{% extends 'base.html.twig' %}

{% block title %}Détails Commande #{{ order.id }} - Brazil Burger{% endblock %}

{% block nav_orders %}active{% endblock %}

{% block page_title %}Commande #{{ order.id }}{% endblock %}
{% block page_subtitle %}Détails et gestion de la commande{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}">Dashboard</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_orders_index') }}">Commandes</a></li>
    <li class="breadcrumb-item active">#{{ order.id }}</li>
{% endblock %}

{% block body %}
<div class="container-fluid px-0">
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pb-0 pt-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <h5 class="card-title mb-1">Commande #{{ order.id }}</h5>
                            <p class="text-muted mb-0">Détails et gestion de la commande</p>
                        </div>
                        <div>
                            <a href="{{ path('app_orders_index') }}" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>
                                Retour
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="card-body">
                    <!-- Informations principales -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="card border-0 bg-light">
                                <div class="card-body">
                                    <h6 class="text-muted mb-3"><i class="bi bi-calendar me-2"></i> Date de commande</h6>
                                    <h4 class="mb-0">{{ order.orderDate ? order.orderDate|date('d/m/Y à H:i') : 'N/A' }}</h4>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="card border-0 bg-light">
                                <div class="card-body">
                                    <h6 class="text-muted mb-3"><i class="bi bi-cash-stack me-2"></i> Montant total</h6>
                                    <h4 class="mb-0 text-success">{{ order.totalPrice }} FCFA</h4>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="card border-0 bg-light">
                                <div class="card-body">
                                    <h6 class="text-muted mb-3"><i class="bi bi-truck me-2"></i> Type de réception</h6>
                                    <h4 class="mb-0">
                                        {% if order.receptionType == 'DELIVERY' %}
                                            <span class="badge bg-info">
                                                <i class="bi bi-truck me-1"></i> Livraison
                                            </span>
                                        {% elseif order.receptionType == 'PICK_UP' %}
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-bag me-1"></i> À emporter
                                            </span>
                                        {% elseif order.receptionType == 'AT_THE_RESTAURANT' %}
                                            <span class="badge bg-success">
                                                <i class="bi bi-shop me-1"></i> Sur place
                                            </span>
                                        {% endif %}
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Détails en deux colonnes -->
                    <div class="row">
                        <!-- Informations client -->
                        <div class="col-md-6">
                            <div class="card border-0">
                                <div class="card-header bg-white border-0 pb-0 pt-3">
                                    <h5 class="card-title">
                                        <i class="bi bi-person-circle me-2"></i>
                                        Informations Client
                                    </h5>
                                </div>
                                <div class="card-body">
                                    {% if order.customer is defined and order.customer is not null %}
                                    <div class="row">
                                        <div class="col-6 mb-3">
                                            <label class="text-muted small">Prénom</label>
                                            <p class="fw-bold mb-0">{{ order.customer.prenom|default(order.customer.firstName|default('N/A')) }}</p>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <label class="text-muted small">Nom</label>
                                            <p class="fw-bold mb-0">{{ order.customer.nom|default(order.customer.lastName|default('N/A')) }}</p>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <label class="text-muted small">Téléphone</label>
                                            <p class="fw-bold mb-0">{{ order.customer.telephone|default('N/A') }}</p>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <label class="text-muted small">Email</label>
                                            <p class="fw-bold mb-0">{{ order.customer.email|default('N/A') }}</p>
                                        </div>
                                    </div>
                                    {% else %}
                                    <div class="text-center py-3">
                                        <i class="bi bi-person-x fs-1 text-muted mb-3"></i>
                                        <p class="text-muted">Informations client non disponibles</p>
                                    </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        
                        <!-- État et actions -->
                        <div class="col-md-6">
                            <div class="card border-0">
                                <div class="card-header bg-white border-0 pb-0 pt-3">
                                    <h5 class="card-title">
                                        <i class="bi bi-gear me-2"></i>
                                        Gestion de la Commande
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <!-- État actuel -->
                                    <div class="mb-4">
                                        <label class="text-muted small">État actuel</label>
                                        <div class="mt-2">
                                            {% if order.orderState == 'PENDING' %}
                                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill py-2 px-4 fs-6">
                                                    <i class="bi bi-clock me-2"></i>
                                                    En Attente
                                                </span>
                                            {% elseif order.orderState == 'CANCELLED' %}
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill py-2 px-4 fs-6">
                                                    <i class="bi bi-x-circle me-2"></i>
                                                    Annulée
                                                </span>
                                            {% elseif order.orderState == 'FINISHED' %}
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill py-2 px-4 fs-6">
                                                    <i class="bi bi-check-circle me-2"></i>
                                                    Terminée
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    
                                    <!-- Changer l'état -->
                                    <div class="mt-4">
                                        <h6 class="mb-3">Changer l'état</h6>
                                        <form action="{{ path('app_orders_update_state', {'id': order.id}) }}" method="post" id="stateForm">
                                            <div class="btn-group w-100" role="group">
                                                <button type="button" 
                                                        class="btn btn-outline-warning {{ order.orderState == 'PENDING' ? 'active' : '' }}" 
                                                        onclick="selectState('PENDING')">
                                                    <i class="bi bi-clock me-2"></i>
                                                    En attente
                                                </button>
                                                <button type="button" 
                                                        class="btn btn-outline-danger {{ order.orderState == 'CANCELLED' ? 'active' : '' }}" 
                                                        onclick="selectState('CANCELLED')">
                                                    <i class="bi bi-x-circle me-2"></i>
                                                    Annuler
                                                </button>
                                                <button type="button" 
                                                        class="btn btn-outline-success {{ order.orderState == 'FINISHED' ? 'active' : '' }}" 
                                                        onclick="selectState('FINISHED')">
                                                    <i class="bi bi-check-circle me-2"></i>
                                                    Terminer
                                                </button>
                                            </div>
                                            
                                            <input type="hidden" name="state" id="selectedState" value="{{ order.orderState }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('update_state' ~ order.id) }}">
                                            
                                            <button type="submit" class="btn btn-primary w-100 mt-3">
                                                <i class="bi bi-save me-2"></i>
                                                Mettre à jour l'état
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Articles commandés -->
                    {% if order.orderLines is defined and order.orderLines|length > 0 %}
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card border-0">
                                <div class="card-header bg-white border-0 pb-0 pt-3">
                                    <h5 class="card-title">
                                        <i class="bi bi-list-ul me-2"></i>
                                        Articles Commandés
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Article</th>
                                                    <th class="text-center">Quantité</th>
                                                    <th class="text-end">Prix unitaire</th>
                                                    <th class="text-end">Total</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for line in order.orderLines %}
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <div class="bg-light rounded p-2 me-3">
                                                                <i class="bi bi-cup-straw text-primary"></i>
                                                            </div>
                                                            <div>
                                                                <strong>{{ line.product.name }}</strong>
                                                                <div class="text-muted small">{{ line.product.description|default('') }}</div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-primary rounded-pill px-3 py-1">
                                                            {{ line.quantity }}
                                                        </span>
                                                    </td>
                                                    <td class="text-end">{{ line.unitPrice }} €</td>
                                                    <td class="text-end fw-bold">{{ line.totalPrice }} €</td>
                                                </tr>
                                                {% endfor %}
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td colspan="3" class="text-end fw-bold">Total commande</td>
                                                    <td class="text-end fw-bold h5 text-success">{{ order.totalPrice }} €</td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    let currentState = '{{ order.orderState }}';
    
    function selectState(state) {
        currentState = state;
        document.getElementById('selectedState').value = state;
        
        // Mettre à jour les styles des boutons
        document.querySelectorAll('#stateForm .btn').forEach(button => {
            button.classList.remove('active');
        });
        
        event.currentTarget.classList.add('active');
    }
    
    // Confirmation pour l'annulation
    document.getElementById('stateForm').addEventListener('submit', function(e) {
        const selectedState = document.getElementById('selectedState').value;
        
        if (selectedState === 'CANCELLED') {
            if (!confirm('Êtes-vous sûr de vouloir annuler cette commande ? Cette action est irréversible.')) {
                e.preventDefault();
            }
        }
    });
</script>
{% endblock %}