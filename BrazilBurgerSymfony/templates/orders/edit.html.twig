{% extends 'base.html.twig' %}

{% block title %}Modifier Commande #{{ order.id }} - Brazil Burger{% endblock %}

{% block nav_orders %}active{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <!-- Header avec navigation -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h4 mb-2 fw-bold">
                <i class="bi bi-pencil-square text-primary me-2"></i>
                Modifier la Commande #{{ order.id }}
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_orders_index') }}" class="text-decoration-none">Commandes</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Modifier #{{ order.id }}</li>
                </ol>
            </nav>
        </div>
        <div>
            <a href="{{ path('app_orders_index') }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Retour
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Formulaire principal -->
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-clipboard-data me-2"></i>Détails de la commande</h5>
                </div>
                <div class="card-body p-4">
                    {{ form_start(form, {'attr': {'class': 'row g-3', 'novalidate': 'novalidate'}}) }}
                    
                    <!-- Section 1: Informations de base -->
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.totalPrice, 'Prix total (FCFA)', {'label_attr': {'class': 'form-label fw-medium'}}) }}
                            <div class="input-group">
                                {{ form_widget(form.totalPrice, {'attr': {'class': 'form-control', 'placeholder': '0.00'}}) }}
                                <span class="input-group-text">FCFA</span>
                            </div>
                            <small class="form-text text-muted">Montant total de la commande</small>
                            {{ form_errors(form.totalPrice) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.orderDate, 'Date de commande', {'label_attr': {'class': 'form-label fw-medium'}}) }}
                            {{ form_widget(form.orderDate, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.orderDate) }}
                        </div>
                    </div>

                    <!-- Section 2: Statuts -->
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.orderState, 'État de la commande', {'label_attr': {'class': 'form-label fw-medium'}}) }}
                            {{ form_widget(form.orderState, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.orderState) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.receptionType, 'Type de réception', {'label_attr': {'class': 'form-label fw-medium'}}) }}
                            {{ form_widget(form.receptionType, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.receptionType) }}
                        </div>
                    </div>

 <!-- Dans votre template, ajoutez des informations utiles -->
<div class="col-md-6">
    <div class="mb-3">
        {{ form_label(form.customer, 'Client', {'label_attr': {'class': 'form-label fw-medium'}}) }}
        {{ form_widget(form.customer, {'attr': {'class': 'form-select'}}) }}
        <small class="form-text text-muted">
            {% if order.customer %}
                Client actuel: {{ order.customer.Name }} {{ order.customer.Surname }}
            {% endif %}
        </small>
        {{ form_errors(form.customer) }}
    </div>
</div>

<div class="col-md-6">
    <div class="mb-3">
        {{ form_label(form.zone, 'Zone de livraison', {'label_attr': {'class': 'form-label fw-medium'}}) }}
        {{ form_widget(form.zone, {'attr': {'class': 'form-select'}}) }}
        <small class="form-text text-muted">
            {% if order.zone %}
                Zone actuelle: {{ order.zone.name }}
            {% else %}
                Non nécessaire pour les commandes sur place ou à emporter
            {% endif %}
        </small>
        {{ form_errors(form.zone) }}
    </div>
</div>

                    <div class="col-12">
                        <div class="mb-3">
                            {{ form_label(form.extra, 'Extras', {'label_attr': {'class': 'form-label fw-medium'}}) }}
                            {{ form_widget(form.extra, {'attr': {'class': 'form-select', 'size': '4'}}) }}
                            <small class="form-text text-muted">
                                Maintenez Ctrl (Cmd sur Mac) pour sélectionner plusieurs extras
                                {% if order.extra|length > 0 %}
                                    <br>Extras actuels: 
                                    {% for extra in order.extra %}
                                        {{ extra.name }}{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                {% endif %}
                            </small>
                            {{ form_errors(form.extra) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-4">
                            {{ form_label(form.payment, 'Paiement associé', {'label_attr': {'class': 'form-label fw-medium'}}) }}
                            {{ form_widget(form.payment, {'attr': {'class': 'form-select'}}) }}
                            <small class="form-text text-muted">
                                {% if order.payment %}
                                    Paiement actuel: 
                                    <strong>{{ order.payment.paymentMethod }}</strong> - 
                                    {{ order.payment.amount|number_format(0, ',', ' ') }} FCFA
                                    (ID: {{ order.payment.id }})
                                {% else %}
                                    Aucun paiement associé
                                {% endif %}
                            </small>
                            {{ form_errors(form.payment) }}
                        </div>
                    </div>

                    <!-- Boutons d'action -->
                    <div class="col-12 pt-3 border-top">
                        <div class="d-flex justify-content-between">
                            <div>
                                <a href="{{ path('app_orders_index') }}" class="btn btn-outline-secondary">
                                    <i class="bi bi-x-circle me-1"></i> Annuler
                                </a>
                            </div>
                            <div>
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="bi bi-check-circle me-1"></i> Enregistrer
                                </button>
                            </div>
                        </div>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>

        <!-- Sidebar: Informations de la commande -->
        <div class="col-lg-4">
            <!-- Carte: Résumé de la commande -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-info-circle me-2"></i>Résumé</h5>
                </div>
                <div class="card-body p-3">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0">
                            <span class="text-muted">ID</span>
                            <span class="fw-medium">#{{ order.id }}</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0">
                            <span class="text-muted">Date</span>
                            <span class="fw-medium">{{ order.orderDate|date('d/m/Y H:i') }}</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0">
                            <span class="text-muted">État</span>
                            <span class="badge bg-{{ order.orderState == 'FINISHED' ? 'success' : (order.orderState == 'PENDING' ? 'warning' : 'danger') }}">
                                {{ order.orderState }}
                            </span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0">
                            <span class="text-muted">Type</span>
                            <span class="fw-medium">
                                {% if order.receptionType == 'DELIVERY' %}
                                    <i class="bi bi-truck me-1"></i>Livraison
                                {% elseif order.receptionType == 'PICK_UP' %}
                                    <i class="bi bi-bag me-1"></i>À emporter
                                {% else %}
                                    <i class="bi bi-shop me-1"></i>Sur place
                                {% endif %}
                            </span>
                        </div>
                        {% if order.deliveryStatus %}
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0">
                            <span class="text-muted">Livraison</span>
                            <span class="badge bg-{{ order.deliveryStatus == 'delivered' ? 'success' : (order.deliveryStatus == 'ongoing' ? 'info' : (order.deliveryStatus == 'pending' ? 'warning' : 'secondary')) }}">
                                {{ order.getDeliveryStatuses()[order.deliveryStatus] ?? order.deliveryStatus }}
                            </span>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Carte: Actions rapides -->
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-lightning me-2"></i>Actions</h5>
                </div>
                <div class="card-body p-3">
                    <div class="d-grid gap-2">
                        {% if order.receptionType == 'DELIVERY' and order.deliveryStatus == 'pending' %}
                            <a href="{{ path('app_delivery_assign', {'id': order.id}) }}" class="btn btn-warning btn-sm">
                                <i class="bi bi-person-check me-1"></i> Affecter livreur
                            </a>
                        {% endif %}
                        
                        <a href="{{ path('app_orders_show', {'id': order.id}) }}" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-eye me-1"></i> Détails
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}