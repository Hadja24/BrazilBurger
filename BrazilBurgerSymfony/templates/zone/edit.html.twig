{% extends 'base.html.twig' %}

{% block title %}Modifier la zone {{ zone.name }} - Brazil Burger{% endblock %}

{% block nav_zones %}active{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --brazil-green: #009739;
            --brazil-yellow: #FEDD00;
            --brazil-blue: #012169;
            --brazil-white: #FFFFFF;
            --brazil-gray: #F5F5F5;
            --brazil-dark: #333333;
        }
        
        .edit-header {
            background: linear-gradient(135deg, var(--brazil-blue), var(--brazil-green));
            color: white;
            padding: 30px;
            border-radius: 12px;
            margin-bottom: 30px;
        }
        
        .tab-content {
            background: var(--brazil-white);
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        
        .nav-tabs {
            border-bottom: 3px solid var(--brazil-gray);
        }
        
        .nav-tabs .nav-link {
            border: none;
            color: var(--brazil-dark);
            font-weight: 600;
            padding: 12px 25px;
            border-radius: 8px 8px 0 0;
            margin-right: 5px;
        }
        
        .nav-tabs .nav-link:hover {
            background-color: var(--brazil-gray);
        }
        
        .nav-tabs .nav-link.active {
            background: linear-gradient(135deg, var(--brazil-green), #00802C);
            color: white;
            border: none;
        }
        
        .neighbourhood-item {
            background: var(--brazil-gray);
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
        }
        
        .neighbourhood-item:hover {
            background: #e9ecef;
        }
        
        .neighbourhood-actions {
            display: flex;
            gap: 10px;
        }
        
        .btn-delete {
            background: linear-gradient(135deg, #EF476F, #FF6B6B);
            color: white;
            border: none;
            border-radius: 20px;
            padding: 6px 15px;
            font-size: 12px;
            font-weight: 600;
        }
        
        .btn-delete:hover {
            background: linear-gradient(135deg, #FF6B6B, #EF476F);
            transform: translateY(-2px);
        }
        
        .no-neighbourhoods {
            text-align: center;
            padding: 40px;
            color: #666;
        }
        
        .deliveryguy-card {
            background: var(--brazil-white);
            border: 2px solid var(--brazil-gray);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 15px;
            transition: all 0.3s ease;
        }
        
        .deliveryguy-card:hover {
            border-color: var(--brazil-green);
            transform: translateY(-2px);
        }
        
        .btn-assign {
            background: linear-gradient(135deg, var(--brazil-blue), #1A3A8F);
            color: white;
            border: none;
            border-radius: 20px;
            padding: 6px 15px;
            font-size: 12px;
            font-weight: 600;
        }
        
        .btn-assign:hover {
            background: linear-gradient(135deg, #1A3A8F, var(--brazil-blue));
            transform: translateY(-2px);
        }
        
        .info-box {
            background: var(--brazil-gray);
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <!-- Header -->
    <div class="edit-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h1 class="mb-2">
                    <i class="fas fa-edit me-2"></i>
                    Modifier la zone : {{ zone.name }}
                </h1>
                <p class="mb-0">
                    <i class="fas fa-money-bill-wave me-2"></i>
                    Prix de livraison : 
                    {% if zone.deliveryPrice %}
                        {{ zone.deliveryPrice|number_format(0, ',', ' ') }} FCFA
                    {% else %}
                        Gratuit
                    {% endif %}
                </p>
            </div>
            <div>
                <a href="{{ path('app_zones_show', {'id': zone.id}) }}" class="btn btn-outline-light me-2">
                    <i class="fas fa-eye me-2"></i>
                    Voir le dashboard
                </a>
                <a href="{{ path('app_zones_index') }}" class="btn btn-light">
                    <i class="fas fa-arrow-left me-2"></i>
                    Retour aux zones
                </a>
            </div>
        </div>
    </div>
    
    <!-- Messages flash -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    
    <!-- Onglets -->
    <ul class="nav nav-tabs mb-4" id="zoneTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab">
                <i class="fas fa-info-circle me-2"></i>
                Informations
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="neighbourhoods-tab" data-bs-toggle="tab" data-bs-target="#neighbourhoods" type="button" role="tab">
                <i class="fas fa-map-pin me-2"></i>
                Quartiers ({{ neighbourhoods|length }})
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="deliveryguys-tab" data-bs-toggle="tab" data-bs-target="#deliveryguys" type="button" role="tab">
                <i class="fas fa-truck me-2"></i>
                Livreurs
            </button>
        </li>
    </ul>
    
    <!-- Contenu des onglets -->
    <div class="tab-content" id="zoneTabsContent">
        <!-- Onglet 1 : Informations -->
        <div class="tab-pane fade show active" id="info" role="tabpanel">
            <h4 class="mb-4" style="color: var(--brazil-dark);">
                <i class="fas fa-cog me-2"></i>
                Modifier les informations de la zone
            </h4>
            
            {{ form_start(form, {'attr': {'class': 'row g-3'}}) }}
                <div class="col-md-6">
                    <div class="mb-3">
                        {{ form_label(form.name, 'Nom de la zone', {'label_attr': {'class': 'form-label fw-medium'}}) }}
                        {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.name) }}
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="mb-3">
                        {{ form_label(form.deliveryPrice, 'Prix de livraison (FCFA)', {'label_attr': {'class': 'form-label fw-medium'}}) }}
                        <div class="input-group">
                            {{ form_widget(form.deliveryPrice, {'attr': {'class': 'form-control'}}) }}
                            <span class="input-group-text">FCFA</span>
                        </div>
                        <small class="form-text text-muted">Laissez vide pour la livraison gratuite</small>
                        {{ form_errors(form.deliveryPrice) }}
                    </div>
                </div>
                
                <div class="col-12">
                    <div class="d-flex justify-content-between">
                        <a href="{{ path('app_zones_index') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-2"></i>
                            Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>
                            Enregistrer les modifications
                        </button>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
        
        <!-- Onglet 2 : Quartiers -->
        <div class="tab-pane fade" id="neighbourhoods" role="tabpanel">
            <div class="row">
                <div class="col-md-6">
                    <h4 class="mb-4" style="color: var(--brazil-dark);">
                        <i class="fas fa-plus-circle me-2"></i>
                        Ajouter un quartier
                    </h4>
                    
                    {{ form_start(neighbourhoodForm, {'attr': {'class': 'row g-3'}}) }}
                        <div class="col-12">
                            <div class="mb-3">
                                {{ form_label(neighbourhoodForm.name, 'Nom du quartier', {'label_attr': {'class': 'form-label fw-medium'}}) }}
                                {{ form_widget(neighbourhoodForm.name, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(neighbourhoodForm.name) }}
                            </div>
                        </div>
                        
                        <div class="col-12">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-plus me-2"></i>
                                Ajouter le quartier
                            </button>
                        </div>
                    {{ form_end(neighbourhoodForm) }}
                </div>
                
                <div class="col-md-6">
                    <h4 class="mb-4" style="color: var(--brazil-dark);">
                        <i class="fas fa-list me-2"></i>
                        Quartiers existants
                    </h4>
                    
                    {% if neighbourhoods|length > 0 %}
                        {% for neighbourhood in neighbourhoods %}
                            <div class="neighbourhood-item">
                                <span class="fw-medium">{{ neighbourhood.name }}</span>
                                <div class="neighbourhood-actions">
                                    <form method="POST" 
                                          action="{{ path('app_zones_delete_neighbourhood', {
                                              'zoneId': zone.id,
                                              'neighbourhoodId': neighbourhood.id
                                          }) }}"
                                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce quartier ?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_neighbourhood' ~ neighbourhood.id) }}">
                                        <button type="submit" class="btn btn-delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="no-neighbourhoods">
                            <i class="fas fa-map-marked-alt fa-3x mb-3"></i>
                            <p class="text-muted">Aucun quartier dans cette zone</p>
                            <p class="text-muted small">Ajoutez votre premier quartier en utilisant le formulaire à gauche</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        
        <!-- Onglet 3 : Livreurs -->
        <div class="tab-pane fade" id="deliveryguys" role="tabpanel">
            <h4 class="mb-4" style="color: var(--brazil-dark);">
                <i class="fas fa-truck-loading me-2"></i>
                Livreurs disponibles
            </h4>
            
            <div class="info-box mb-4">
                <h5 class="mb-2">
                    <i class="fas fa-info-circle me-2"></i>
                    Information
                </h5>
                <p class="mb-0">
                    Pour affecter des livreurs à cette zone de manière permanente, il faut d'abord modifier l'entité Zone pour ajouter une relation avec DeliveryGuy.
                    Actuellement, les livreurs sont affectés aux commandes individuellement.
                </p>
            </div>
            
            {% if availableDeliveryGuys|length > 0 %}
                <div class="row">
                    {% for deliveryGuy in availableDeliveryGuys %}
                        <div class="col-md-6">
                            <div class="deliveryguy-card">
                                <div class="row align-items-center">
                                    <div class="col-8">
                                        <h6 class="mb-1">{{ deliveryGuy.account.name }} {{ deliveryGuy.account.surname }}</h6>
                                        <p class="mb-1 text-muted small">
                                            <i class="fas fa-phone me-1"></i>
                                            {{ deliveryGuy.account.phone }}
                                        </p>
                                        <p class="mb-0 text-muted small">
                                            <i class="fas fa-envelope me-1"></i>
                                            {{ deliveryGuy.account.email }}
                                        </p>
                                    </div>
                                    <div class="col-4 text-end">
                                        <form method="POST" 
                                              action="{{ path('app_zones_assign_deliveryguy', {
                                                  'zoneId': zone.id,
                                                  'deliveryGuyId': deliveryGuy.id
                                              }) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('assign_deliveryguy' ~ deliveryGuy.id) }}">
                                            <button type="submit" class="btn btn-assign" disabled title="Fonctionnalité à venir">
                                                <i class="fas fa-link me-1"></i>
                                                Affecter
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="no-neighbourhoods">
                    <i class="fas fa-truck fa-3x mb-3"></i>
                    <p class="text-muted">Aucun livreur disponible</p>
                    <p class="text-muted small">Créez d'abord des comptes livreurs</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Initialisation des onglets
        const triggerTabList = document.querySelectorAll('#zoneTabs button');
        triggerTabList.forEach(triggerEl => {
            const tabTrigger = new bootstrap.Tab(triggerEl);
            
            triggerEl.addEventListener('click', event => {
                event.preventDefault();
                tabTrigger.show();
            });
        });
        
        // Confirmation avant suppression
        document.querySelectorAll('.btn-delete').forEach(button => {
            button.addEventListener('click', function(e) {
                if (!confirm('Êtes-vous sûr de vouloir supprimer ce quartier ? Cette action est irréversible.')) {
                    e.preventDefault();
                }
            });
        });
        
        // Auto-dismiss alerts
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
{% endblock %}